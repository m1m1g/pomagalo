# Изходът на Maven — съставя се наново при всяко сглобяване.
target/

# Развойната среда. IntelliJ я прави сама, щом отвори pom.xml.
.idea/
*.iml

# Базата с песнопенията. Приложението я създава празна при първо пускане;
# в хранилището тя би била чужди данни.
*.db

# Онтологията е една. В хранилището отива само действащата; всяко друго
# копие — резервно, изнесено наново от Protégé или донесено от работния
# плот — остава при Вас. Правилото е с отрицание нарочно: тъй новото
# копие, дори да го сложите утре в папката, не тръгва само.
*.owl
*.owl.*
!data/byzantine_music4.owl

# Резервните копия под старото им име.
data/*.predi_*

# JADE ги поражда сам при всяко пускане и вписва в тях името на машината.
APDescription.txt
MTPs-Main-Container.txt
