###  http://www.paralagia.bg/ontology/vizantiiska-muzika#StepDi
:StepDi rdf:type owl:NamedIndividual ,
                 :ParalagiaStep ;
        :belongsToTetrachord :UpperTetrachord ;
        :description "Пета стъпка на солфежната скала (Δη = Сол / G4, 391.995 Hz). Устой на Втори (Β΄) и Четвърти (Δ΄) глас. Първата степен на горния тетрахорд. Означава се с буквата „Δ“ в нотописа."@bg ;
        :frequency 391.995 ;
        :paralagiasSyllable "Δη" ;
        :stepOrder 5 ;
        :greekName "Δη" ;
        rdfs:comment "Пета стъпка (Δη = Сол, 392 Hz). Устой на Втори (Β΄) и Четвърти (Δ΄) глас. Първата степен на горния тетрахорд."@bg ;
        rdfs:label "Di – Fifth Paralagia Step (G, 391.995 Hz)"@en ,
                   "Δη"@el ,
                   "Δη – Пета стъпка (Сол, 391.995 Hz)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#StepGa
:StepGa rdf:type owl:NamedIndividual ,
                 :ParalagiaStep ;
        :belongsToTetrachord :LowerTetrachord ;
        :description "Четвърта стъпка на солфежната скала (Γα = Фа / F4, 349.228 Hz). Устой на Трети (Γ΄) и Седми (Βαρύς ήχος) глас. Последната степен на долния тетрахорд. Означава се с буквата „Γ“ в нотописа."@bg ;
        :frequency 349.228 ;
        :paralagiasSyllable "Γα" ;
        :stepOrder 4 ;
        :greekName "Γα" ;
        rdfs:comment "Четвърта стъпка (Γα = Фа, 349 Hz). Устой на Трети (Γ΄) и Седми (Βαρύς ήχος) глас. Последната степен на долния тетрахорд."@bg ;
        rdfs:label "Ga – Fourth Paralagia Step (F, 349.228 Hz)"@en ,
                   "Γα"@el ,
                   "Γα – Четвърта стъпка (Фа, 349.228 Hz)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#StepKe
:StepKe rdf:type owl:NamedIndividual ,
                 :ParalagiaStep ;
        :belongsToTetrachord :UpperTetrachord ;
        :description "Шеста стъпка на солфежната скала (Κε = Ла / A4, 440 Hz). Няма глас с устой на нея. Камертонният тон. В хроматичните гласове може да се понижава. Означава се с буквата „Κ“ в нотописа."@bg ;
        :frequency 440.0 ;
        :paralagiasSyllable "Κε" ;
        :stepOrder 6 ;
        :greekName "Κε" ;
        rdfs:comment "Шеста стъпка (Κε = Ла, 440 Hz). Няма глас с устой на нея. Камертонният тон. В хроматичните гласове може да се понижава."@bg ;
        rdfs:label "Ke – Sixth Paralagia Step (A, 440 Hz)"@en ,
                   "Κε"@el ,
                   "Κε – Шеста стъпка (Ла, 440 Hz)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#StepNi
:StepNi rdf:type owl:NamedIndividual ,
                 :ParalagiaStep ;
        :belongsToTetrachord :LowerTetrachord ;
        :description "Първа стъпка на солфежната скала (Νη = До / C4, 261.626 Hz). Устой на Осми глас (πλ. δ΄). Началото на долния тетрахорд. Означава се с буквата „Ν“ в нотописа."@bg ;
        :frequency 261.626 ;
        :paralagiasSyllable "Νη" ;
        :stepOrder 1 ;
        :greekName "Νη" ;
        rdfs:comment "Първа стъпка (Νη = До, 262 Hz). Устой на Осми глас (πλ. δ΄). Началото на долния тетрахорд."@bg ;
        rdfs:label "Ni – First Paralagia Step (C, 261.626 Hz)"@en ,
                   "Νη"@el ,
                   "Νη – Първа стъпка (До, 261.626 Hz)"@bg .


