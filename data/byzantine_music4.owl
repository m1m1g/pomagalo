          rdfs:comment "A twisting ornament — complex melodic turn."@en ,
                       "Стрептон – невма за мелизма; означава малко мелодично украшение."@bg ;
          rdfs:label "Strepton"@en ,
                     "Στρεπτόν"@el ,
                     "Стрептон (завъртане)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Trigorgon
:Trigorgon rdf:type owl:NamedIndividual ,
                    :RhythmicNeume ;
           :hasImageData "images/sign_trigorgon.png" ;
           rdfs:comment "Halves the duration three times — very fast."@en ,
                        "Тригоргон – тройно ускорение; среща се рядко."@bg ;
           rdfs:label "Trigorgon"@en ,
                      "Τριγοργόν"@el ,
                      "Тригоргон (тройно ускорение)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#UpperTetrachord
:UpperTetrachord rdf:type owl:NamedIndividual ,
