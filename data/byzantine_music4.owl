###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Elaphron
:Elaphron rdf:type owl:NamedIndividual ,
                   :BodyNeume ;
          :representsStep :StepVu ;
          :description "Движение надолу с две стъпки."@bg ;
          :intervalSemitones -4 ;
          :intervalValue -2 ;
          :greekName "Ἐλαφρόν" ;
          :hasImageData "images/sign_elaphron.png" ;
          rdfs:comment "Two steps down."@en ,
                       "Елафрон – движение с две стъпки надолу (−2)."@bg ,
                       "Елафрон – низходяща невма; движение с две стъпки надолу. Интервал: −2."@bg ;
          rdfs:label "Elaphron (two steps down)"@en ,
                     "Елафрон (две стъпки надолу)"@bg ,
                     "Ἐλαφρόν"@el .


