:AthoniteTradition :traditionKey "athonite" ;
                   rdfs:label "Athonite tradition"@en ,
                              "Света Гора (атонска традиция)"@bg .


:BulgarianChantingTradition :traditionKey "bulgarian" ;
                            rdfs:label "Bulgarian chanting tradition"@en ,
                                       "Българска певческа традиция"@bg .


:ConstantinopolitanSchool :traditionKey "constantinopolitan" ;
                          rdfs:label "Constantinopolitan School"@en ,
                                     "Константинополска певческа школа"@bg .


:EasternOrthodoxTradition :traditionKey "eastern-orthodox" ;
                          rdfs:label "Eastern Orthodox Tradition"@en ,
                                     "Източноправославна певческа традиция"@bg .


#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( :MusicalNote
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isDiatonicNote ;
                         owl:hasValue "false"^^xsd:boolean
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ChromaticNote
] .


[ owl:intersectionOf ( :MusicalNote
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isDiatonicNote ;
                         owl:hasValue "true"^^xsd:boolean
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :DiatonicNote
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AthoniteTradition
                :BulgarianChantingTradition
                :ConstantinopolitanSchool
              ) ;
  rdfs:comment "Трите певчески традиции са класификационно несъвместими."@bg
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :BodyNeume
                :Martyria
                :Modifier
                :OrnamentalNeume
                :Phthora
                :RhythmicNeume
              ) ;
  rdfs:comment "Шестте вида невми са класификационно несъвместими: един знак не може да бъде едновременно тяло, украшение, ритмичен знак, мартирия, фтора или промяна."@bg
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Compline
                :DivineLiturgy
                :Hours
                :Matins
                :Vespers
              ) ;
  rdfs:comment "Основните православни богослужения са несъвместими видове: едно богослужение не може да бъде едновременно Литургия, Вечерня, Утреня, Часове и Повечерие."@bg
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :EarlyByzantineNotation
                :MiddleByzantineNotation
                :NewAnalyticalNotation
              ) ;
  rdfs:comment "Трите нотационни системи принадлежат към различни исторически периоди и са несъвместими в класификацията."@bg
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :AthoniteTradition
                        :BulgarianChantingTradition
                        :ConstantinopolitanSchool
                        :EasternOrthodoxTradition
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Mode1
                        :Mode2
                        :Mode3
                        :Mode4
                        :Mode5
                        :Mode6
                        :Mode7
                        :Mode8
                      ) ;
  rdfs:comment "Осемте гласа на осмогласната система са взаимно различни индивиди (Глас1–Глас8)."@bg
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :StepDi
                        :StepGa
                        :StepKe
                        :StepNi
                        :StepPa
                        :StepVu
                        :StepZo
                      ) ;
  rdfs:comment "Седемте стъпки (Νη, Πα, Βου, Γα, Δη, Κε, Ζω) са взаимно различни индивиди. Reasoner-ът не може да ги отъждествява."@bg
] .


