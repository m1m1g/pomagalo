@prefix : <http://www.paralagia.bg/ontology/vizantiiska-muzika#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.paralagia.bg/ontology/vizantiiska-muzika#> .

<http://www.paralagia.bg/ontology/vizantiiska-muzika> rdf:type owl:Ontology ;
                                                       <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by-sa/4.0/" ;
                                                       rdfs:comment "Created for educational and research purposes in the domain of the eastern orthodox chanting tradition"@en ,
                                                                    "Създадена за образователни и изследователски цели в областта на православната певческа традиция."@bg ;
                                                       owl:versionInfo "1.2" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#birthYear
:birthYear rdf:type owl:AnnotationProperty ;
           rdfs:range xsd:integer ;
           rdfs:domain :Person .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#churchSlavonicName
:churchSlavonicName rdf:type owl:AnnotationProperty ;
                    rdfs:comment "Наименованието в църковнославянски език"@bg ;
                    rdfs:label "Църковнославянско наименование"@bg ;
                    rdfs:range xsd:string ;
                    rdfs:domain owl:Thing .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#deathYear
:deathYear rdf:type owl:AnnotationProperty ;
           rdfs:range xsd:integer ;
           rdfs:domain :Person .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#greekName
:greekName rdf:type owl:AnnotationProperty ;
           rdfs:comment "Оригиналното гръцко наименование на термина"@bg ;
           rdfs:label "Гръцко наименование"@bg ;
           rdfs:range xsd:string ;
           rdfs:domain owl:Thing .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasImageData
:hasImageData rdf:type owl:AnnotationProperty ;
              rdfs:range xsd:string ;
              rdfs:domain owl:Thing .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasImageSource
:hasImageSource rdf:type owl:AnnotationProperty ;
                rdfs:range xsd:string ;
                rdfs:domain owl:Thing .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#notesPerSyllableMax
:notesPerSyllableMax rdf:type owl:AnnotationProperty .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#notesPerSyllableMin
:notesPerSyllableMin rdf:type owl:AnnotationProperty .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#quizQuery
:quizQuery rdf:type owl:AnnotationProperty ;
           rdfs:comment "SPARQL заявка, използвана за генериране на тестов въпрос. Форматът е JSON: {\"q_bg\": \"Въпрос\", \"q_en\": \"Question\", \"sparql\": \"SELECT...\", \"answer_var\": \"?x\", \"topic\": \"category\"}"@bg ;
           rdfs:label "Quiz query"@en ,
                      "Тестов въпрос"@bg ;
           rdfs:range xsd:string ;
           rdfs:domain owl:Thing .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#styleKey
:styleKey rdf:type owl:AnnotationProperty .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#traditionKey
:traditionKey rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.paralagia.bg/ontology/vizantiiska-muzika#accompaniedBy
:accompaniedBy rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :Performance ;
               rdfs:range :Ensemble ;
               rdfs:comment "Links a work to instrumental or choral accompaniment in performance."@en ,
                            "Свързва произведение с даден акомпанимент"@bg ;
               rdfs:label "accompanied by"@en ,
                          "придружено от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#adaptedFrom
:adaptedFrom rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :basedOn ;
             owl:inverseOf :hasAdaptation ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :MusicalWork ;
             rdfs:comment "Links an adapted work to the original (e.g., renotation, harmonization)."@en ,
                          "Указва адаптация от по-ранно произведение."@bg ;
             rdfs:label "adapted from"@en ,
                        "адаптирано от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#appearsBefore
:appearsBefore rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain :MusicalWork ;
               rdfs:range :MusicalWork ;
               rdfs:label "appears before"@en ,
                          "появява се преди"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ascendsTo
:ascendsTo rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :MusicalWork ;
           rdfs:range :ParalagiaStep ;
           rdfs:label "ascends to"@en ,
                      "възхожда до"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#associatedWith
:associatedWith rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Person ;
                rdfs:range :Person ;
                rdfs:label "associated with"@en ,
                           "свързан с"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#attributedTo
:attributedTo rdf:type owl:ObjectProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :MusicalWork ;
              rdfs:range :Composer ;
              owl:propertyDisjointWith :composedBy ;
              rdfs:comment "Links a work to a composer to whom it is traditionally attributed (when composer is uncertain)."@en ,
                           "Свързва произведение с предполагаемия му автор."@bg ;
              rdfs:label "attributed to"@en ,
                         "приписан на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#authenticOf
:authenticOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :relatedMode ;
             owl:inverseOf :plagalOf ;
             rdf:type owl:FunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Mode ;
             rdfs:range :Mode ;
             rdfs:comment "Links an authentic mode to its plagal counterpart."@en ,
                          "Обратното на plagalOf."@bg ;
             rdfs:label "authentic of"@en ,
                        "е автентичен глас на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#basedOn
:basedOn rdf:type owl:ObjectProperty ;
         owl:inverseOf :hasDerivative ;
         rdf:type owl:AsymmetricProperty ,
                  owl:IrreflexiveProperty ;
         rdfs:domain :MusicalWork ;
         rdfs:range :MusicalWork ;
         rdfs:comment "Links a musical work to another work it is based upon (e.g., contrafactum, recomposition)."@en ,
                      "Указва, че едно произведение е деривативно на друго"@bg ;
         rdfs:label "based on"@en ,
                    "основава се на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#belongsToNotationSystem
:belongsToNotationSystem rdf:type owl:ObjectProperty ,
                                  owl:FunctionalProperty ,
                                  owl:AsymmetricProperty ,
                                  owl:IrreflexiveProperty ;
                         rdfs:domain :Neume ;
                         rdfs:range :NotationSystem ;
                         rdfs:comment "Links a neume to the notational system it belongs to."@en ;
                         rdfs:label "belongs to notation system"@en ,
                                    "принадлежи към нотационна система"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#belongsToSchool
:belongsToSchool rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain :Person ;
                 rdfs:range :ChantingSchool ;
                 rdfs:comment "Свързва певец или мелодист с певческата школа, в която е обучен."@bg ;
                 rdfs:label "belongs to chanting school"@en ,
                            "принадлежи към певческа школа"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#belongsToService
:belongsToService rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :Hymn ;
                  rdfs:range :LiturgicalService ;
                  rdfs:comment "Указва богослужението, към което принадлежи химнът."@bg ;
                  rdfs:label "belongs to service"@en ,
                             "принадлежи към богослужение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#belongsToTetrachord
:belongsToTetrachord rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain :ParalagiaStep ;
                     rdfs:range :Scale ;
                     rdfs:comment "Указва към кой тетрахорд (или пентахорд) принадлежи стъпката (по теорията на Хрисант)."@bg ;
                     rdfs:label "belongs to tetrachord"@en ,
                                "принадлежи към тетрахорд"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#belongsToTradition
:belongsToTradition rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ,
                             owl:AsymmetricProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain :Hymn ;
                    rdfs:range :ChantingSchool ;
                    rdfs:comment "Указва певческата традиция или школа, към която принадлежи химнът."@bg ;
                    rdfs:label "belongs to chanting tradition"@en ,
                               "принадлежи към певческа традиция"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#celebratesFeast
:celebratesFeast rdf:type owl:ObjectProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain :Service ;
                 rdfs:range :FeastDay ;
                 rdfs:comment "Links a liturgical service to the feast it celebrates."@en ;
                 rdfs:label "celebrates feast"@en ,
                            "прославя празник"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#centresOn
:centresOn rdf:type owl:ObjectProperty ;
           rdfs:domain :MusicalWork ;
           rdfs:range :ParalagiaStep ;
           rdfs:comment "Links a work to the syllable serving as melodic center."@en ,
                        "Указва централната нота, към която се стреми произведението"@bg ;
           rdfs:label "centres on"@en ,
                      "центрира се около"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#characterizedBy
:characterizedBy rdf:type owl:ObjectProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain :Mode ;
                 rdfs:range :EthosQuality ;
                 rdfs:comment "Links a mode to its characteristic emotional or spiritual quality."@en ;
                 rdfs:label "characterized by"@en ,
                            "характеризира се с"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#citedIn
:citedIn rdf:type owl:ObjectProperty ,
                  owl:AsymmetricProperty ,
                  owl:IrreflexiveProperty ;
         rdfs:domain :MusicalWork ;
         rdfs:range :Publication ;
         rdfs:comment "Links a work to publications that reference it."@en ;
         rdfs:label "cited in"@en ,
                    "цитирано в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#collaboratedWith
:collaboratedWith rdf:type owl:ObjectProperty ,
                           owl:SymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :Person ;
                  rdfs:range :Person ;
                  rdfs:comment "Links two composers who worked together."@en ,
                               "Свързва двама музиканти, работили съвместно."@bg ;
                  rdfs:label "collaborated with"@en ,
                             "работил съвместно с"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#composedBy
:composedBy rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Hymn ;
            rdfs:range :Person ;
            rdfs:comment "Указва автора-мелодописец на химна."@bg ;
            rdfs:label "composed by"@en ,
                       "съчинен от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#conductedBy
:conductedBy rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Performance ;
             rdfs:range :Person ;
             rdfs:comment "Links a performance to its conductor or leader."@en ;
             rdfs:label "conducted by"@en ,
                        "дирижирано от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#connectsToService
:connectsToService rdf:type owl:ObjectProperty ;
                   rdfs:domain :MusicalWork ;
                   rdfs:range :LiturgicalService ;
                   rdfs:comment "Links a work to a specific liturgical service or cycle."@en ;
                   rdfs:label "connects to service"@en ,
                              "свързан с богослужение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#containedIn
:containedIn rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Hymn ;
             rdfs:range :LiturgicalBook ;
             rdfs:comment "Указва певческата книга, в която е включен химнът."@bg ;
             rdfs:label "contained in"@en ,
                        "съдържа се в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#containsNeume
:containsNeume rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :Hymn ;
               rdfs:range :Neume ;
               rdfs:comment "Указва невмите, използвани в нотирането на химна."@bg ;
               rdfs:label "contains neume"@en ,
                          "съдържа невма"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#contemporaryOf
:contemporaryOf rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Person ;
                rdfs:range :Person ;
                rdfs:comment "Links composers who lived and worked in the same period."@en ,
                             "Свързва двама музиканти, живели по едно и също време."@bg ;
                rdfs:label "contemporary of"@en ,
                           "съвременник на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#continuedBy
:continuedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :continuesFrom ;
             rdf:type owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Tradition ;
             rdfs:range :Tradition ;
             rdfs:comment "Links a tradition or practice to its successor."@en ;
             rdfs:label "continued by"@en ,
                        "продължен от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#continuesFrom
:continuesFrom rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :Tradition ;
               rdfs:range :Tradition ;
               rdfs:comment "Links a tradition to its predecessor."@en ;
               rdfs:label "continues from"@en ,
                          "продължава от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#corresponds
:corresponds rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:domain :Manuscript ;
             rdfs:range :Manuscript ;
             rdfs:comment "Indicates correspondence between different manuscript versions."@en ;
             rdfs:label "corresponds to"@en ,
                        "съответства на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#dateOfCopying
:dateOfCopying rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :Manuscript ;
               rdfs:range :HistoricalPeriod ;
               rdfs:comment "Links a manuscript to its historical period of copying."@en ;
               rdfs:label "copied during"@en ,
                          "преписан по времето на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#dedicatedTo
:dedicatedTo rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :Person ;
             rdfs:comment "Links a work to a person to whom it is dedicated."@en ;
             rdfs:label "dedicated to"@en ,
                        "посветен на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#descendsTo
:descendsTo rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :MusicalWork ;
            rdfs:range :ParalagiaStep ;
            rdfs:comment "Lowest note in the work."@en ;
            rdfs:label "descends to"@en ,
                       "низхожда до"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#discussedInWork
:discussedInWork rdf:type owl:ObjectProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain :MusicalWork ;
                 rdfs:range :ScholarlyWork ;
                 rdfs:comment "Links a work to scholarly publications that discuss it."@en ;
                 rdfs:label "discussed in work"@en ,
                            "обсъдено в произведение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#documentedIn
:documentedIn rdf:type owl:ObjectProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :MusicalWork ;
              rdfs:range :Source ;
              rdfs:comment "Links a tradition or work to its historical documentation or sources."@en ;
              rdfs:label "documented in"@en ,
                         "документиран в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#editedBy
:editedBy rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :MusicalWork ;
          rdfs:range :Person ;
          rdfs:comment "Links a published edition to its editor."@en ;
          rdfs:label "edited by"@en ,
                     "редактирано от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#evolvedFrom
:evolvedFrom rdf:type owl:ObjectProperty ;
             owl:inverseOf :evolvedInto ;
             rdf:type owl:TransitiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :MusicalWork ;
             rdfs:comment "Обратното на evolvedInto."@bg ;
             rdfs:label "evolved from"@en ,
                        "еволюирал от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#evolvedInto
:evolvedInto rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :MusicalWork ;
             rdfs:comment "Links an older form of a work to its later development."@en ,
                          "Показва, как един певчески стил или форма се е развил в друг."@bg ;
             rdfs:label "evolved into"@en ,
                        "еволюирал в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#flourishedDuring
:flourishedDuring rdf:type owl:ObjectProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :Person
                                              :Tradition
                                            )
                              ] ;
                  rdfs:range :HistoricalPeriod ;
                  rdfs:comment "Links a tradition or person to their period of greatest influence."@en ;
                  rdfs:label "flourished during"@en ,
                             "процъфтял по времето на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#foundInArchive
:foundInArchive rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :MusicalWork ;
                rdfs:range :ManuscriptSource ;
                rdfs:comment "Links a work to the manuscript or archive where it is stored."@en ,
                             "Свързва ръкопис или документ с архива, в който се съхранява."@bg ;
                rdfs:label "found in archive"@en ,
                           "намерен в архив"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasAdaptation
:hasAdaptation rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasDerivative ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :MusicalWork ;
               rdfs:range :MusicalWork ;
               rdfs:comment "Обратното на adaptedFrom."@bg ;
               rdfs:label "has adaptation"@en ,
                          "има адаптация"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasAlternativeMelody
:hasAlternativeMelody rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain :MusicalWork ;
                      rdfs:range :MusicalWork ;
                      owl:propertyDisjointWith :hasAlternativeText ;
                      rdfs:comment "Links a work to an alternate melodic rendering or recomposition."@en ;
                      rdfs:label "has alternative melody"@en ,
                                 "има алтернативна мелодия"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasAlternativeText
:hasAlternativeText rdf:type owl:ObjectProperty ,
                             owl:AsymmetricProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain :MusicalWork ;
                    rdfs:range :Text ;
                    rdfs:comment "Links a work to an alternate textual version or variant."@en ;
                    rdfs:label "has alternative text"@en ,
                               "има алтернативен текст"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasApechema
:hasApechema rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Mode ;
             rdfs:range :Apechema ;
             rdfs:label "има апихима"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasAscendingFormula
:hasAscendingFormula rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Mode ;
                     rdfs:range :MelodicFormula ;
                     rdfs:label "има възходящ оборот"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasCadentialFormula
:hasCadentialFormula rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Mode ;
                     rdfs:range :CadentialFormula ;
                     rdfs:label "има каданс"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasDerivative
:hasDerivative rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :MusicalWork ;
               rdfs:range :MusicalWork ;
               rdfs:comment "Свързва оригинал с производна версия или адаптация."@bg ;
               rdfs:label "has derivative"@en ,
                          "има производна форма"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasDescendingFormula
:hasDescendingFormula rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Mode ;
                      rdfs:range :MelodicFormula ;
                      rdfs:label "има низходящ оборот"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasFinal
:hasFinal rdf:type owl:ObjectProperty ;
          owl:inverseOf :isFinalOfMode ;
          rdf:type owl:FunctionalProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :Mode ;
          rdfs:range :ParalagiaStep ;
          rdfs:comment "Links a mode to its finalis (concluding tone)."@en ,
                       "Свързва глас с неговия финален тон (базова нота на гласа)."@bg ;
          rdfs:label "has final"@en ,
                     "έχει φθόρα"@el ,
                     "има финален тон"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasIson
:hasIson rdf:type owl:ObjectProperty ;
         owl:inverseOf :isIsonOfMode ;
         rdf:type owl:FunctionalProperty ,
                  owl:AsymmetricProperty ,
                  owl:IrreflexiveProperty ;
         rdfs:domain :Mode ;
         rdfs:range :ParalagiaStep ;
         rdfs:comment "Links a mode to its ison (drone tone)."@en ,
                      "Свързва глас с неговия тон на исона (бурдон)."@bg ;
         rdfs:label "has ison"@en ,
                    "έχει ίσον"@el ,
                    "има исон"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasNeumaticVersion
:hasNeumaticVersion rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isNeumaticVersionOf ;
                    rdf:type owl:AsymmetricProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain :MusicalWork ;
                    rdfs:range :MusicalWork ;
                    owl:propertyDisjointWith :hasTextAccompaniment ;
                    rdfs:comment "Links a work to an alternate neumatic notation or manuscript version."@en ;
                    rdfs:label "has neumatic version"@en ,
                               "има невматична версия"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasParalagiaStep
:hasParalagiaStep rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :MusicalNote ;
                  rdfs:range :ParalagiaStep ;
                  rdfs:comment "Всяка музикална нота принадлежи към точно ЕДНА стъпка. Reasoner-ът може да изведе еднозначност чрез функционалното свойство."@bg ,
                               "Свързва музикална нота (MIDI нота) със стъпката (Νη, Πα, Βου, Γα, Δη, Κε, Ζω), към която тя принадлежи в системата на осмогласието."@bg ;
                  rdfs:label "has paralagia step"@en ,
                             "има стъпка"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasStep
:hasStep rdf:type owl:ObjectProperty ;
         rdfs:domain :MelodicFormula ;
         rdfs:range :PatternStep ;
         rdfs:label "има стъпка"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasSuccessor
:hasSuccessor rdf:type owl:ObjectProperty ;
              owl:inverseOf :successorOf ;
              rdf:type owl:TransitiveProperty ;
              rdfs:domain :Person ;
              rdfs:range :Person ;
              rdfs:comment "Обратното на successorOf."@bg ;
              rdfs:label "has successor"@en ,
                         "има приемник"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasTextAccompaniment
:hasTextAccompaniment rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain :MusicalWork ;
                      rdfs:range :Text ;
                      rdfs:comment "Links a musical work to its primary liturgical text or scriptural reference."@en ;
                      rdfs:label "has text accompaniment"@en ,
                                 "има текстово придружение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#hasVariant
:hasVariant rdf:type owl:ObjectProperty ;
            owl:equivalentProperty :variantOf ;
            owl:inverseOf :variantOf ;
            rdf:type owl:SymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :MusicalWork ;
            rdfs:range :MusicalWork ;
            rdfs:comment "Обратното на variantOf."@bg ;
            rdfs:label "has variant"@en ,
                       "има вариант"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#honorsSaint
:honorsSaint rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :Saint ;
             rdfs:comment "Links a work to the saint commemorated by it."@en ;
             rdfs:label "honours saint"@en ,
                        "почита светец"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#influencedBy
:influencedBy rdf:type owl:ObjectProperty ;
              owl:inverseOf :influencedComposer ;
              rdf:type owl:TransitiveProperty ;
              rdfs:domain :Person ;
              rdfs:range :Person ;
              rdfs:comment "Links a composer or musician to figures or traditions that shaped their work."@en ;
              rdfs:label "influenced by"@en ,
                         "повлиян от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#influencedComposer
:influencedComposer rdf:type owl:ObjectProperty ,
                             owl:TransitiveProperty ;
                    rdfs:domain :Person ;
                    rdfs:range :Person ;
                    rdfs:comment "Links a composer to those whom they influenced."@en ;
                    rdfs:label "influenced composer"@en ,
                               "повлиял на композитор"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#integratesWork
:integratesWork rdf:type owl:ObjectProperty ;
                rdfs:domain :LiturgicalService ;
                rdfs:range :MusicalWork ;
                rdfs:comment "Links a liturgical service to its constituent musical works."@en ;
                rdfs:label "integrates work"@en ,
                           "включва произведение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#isFinalOfMode
:isFinalOfMode rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :ParalagiaStep ;
               rdfs:range :Mode ;
               rdfs:comment "Указва кой глас (ηχος) финализира (завършва) на тази стъпка."@bg ;
               rdfs:label "is final of mode"@en ,
                          "е финал на глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#isIsonOfMode
:isIsonOfMode rdf:type owl:ObjectProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :ParalagiaStep ;
              rdfs:range :Mode ;
              rdfs:comment "Указва кой глас използва тази стъпка като исон (основен задържан тон/бурдон)."@bg ;
              rdfs:label "is ison of mode"@en ,
                         "е исон на глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#isNeumaticVersionOf
:isNeumaticVersionOf rdf:type owl:ObjectProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain :MusicalWork ;
                     rdfs:range :MusicalWork ;
                     rdfs:label "is neumatic version of"@en ,
                                "е невматична версия на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#isUsedInWork
:isUsedInWork rdf:type owl:ObjectProperty ;
              owl:inverseOf :usesNeume ;
              rdf:type owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :Neume ;
              rdfs:range :MusicalWork ;
              rdfs:comment "Обратното на usesNeume – свързва невма с произведението, в което се среща."@bg ;
              rdfs:label "is used in work"@en ,
                         "използва се в произведение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#manuscriptSource
:manuscriptSource rdf:type owl:ObjectProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :MusicalWork ;
                  rdfs:range :Manuscript ;
                  rdfs:comment "Links a modern edition to its source manuscript."@en ;
                  rdfs:label "manuscript source"@en ,
                             "ръкописен извор"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#memberOf
:memberOf rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :Person ;
          rdfs:range :Ensemble ;
          rdfs:comment "Links a person to a choral ensemble or musical institution."@en ;
          rdfs:label "member of"@en ,
                     "член на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#mentorBy
:mentorBy rdf:type owl:ObjectProperty ;
          owl:inverseOf :mentorOf ;
          rdf:type owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :Person ;
          rdfs:range :Person ;
          rdfs:comment "Обратното на mentorOf."@bg ;
          rdfs:label "mentored by"@en ,
                     "наставляван от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#mentorOf
:mentorOf rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :Person ;
          rdfs:range :Person ;
          rdfs:comment "Links a mentor composer to their student."@en ,
                       "Свързва учител с ученик (наставничество)."@bg ;
          rdfs:label "mentor of"@en ,
                     "наставник на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#modifiesBy
:modifiesBy rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Neume ;
            rdfs:range :Modifier ;
            rdfs:comment "Links a neume to its modifiers (e.g., Ison, Apostrophos, Hyporhoe)."@en ;
            rdfs:label "modified by"@en ,
                       "модифицира чрез"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#modulates
:modulates rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :MusicalWork ;
           rdfs:range :Echos ;
           rdfs:comment "Indicates modal or tonal shift within or to another work."@en ;
           rdfs:label "modulates to"@en ,
                      "модулира към"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#musicallyRelatedTo
:musicallyRelatedTo rdf:type owl:ObjectProperty ,
                             owl:SymmetricProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain :MusicalWork ;
                    rdfs:range :MusicalWork ;
                    rdfs:comment "Denotes a general musical relationship between works (melodic, harmonic, or structural)."@en ;
                    rdfs:label "musically related to"@en ,
                               "музикално свързан с"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#notatedBy
:notatedBy rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Manuscript ;
           rdfs:range :Person ;
           rdfs:comment "Links a manuscript to the scribe or notator."@en ;
           rdfs:label "notated by"@en ,
                      "нотиран от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#notatedUsing
:notatedUsing rdf:type owl:ObjectProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :Hymn ;
              rdfs:range :NotationSystem ;
              rdfs:comment "Указва нотационната система, в която е записан химнът."@bg ;
              rdfs:label "notated using"@en ,
                         "записан в нотация"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#noteFinalizesOnMode
:noteFinalizesOnMode rdf:type owl:ObjectProperty ;
                     rdfs:domain :MusicalNote ;
                     rdfs:range :Mode ;
                     owl:propertyChainAxiom ( :hasParalagiaStep
                                              :isFinalOfMode
                                            ) ;
                     rdfs:comment "Изведено свойство чрез верига от две свойства: стъпката на нотата и гласът, който тази стъпка затваря. Ако нота принадлежи към стъпка, която е финален тон на даден глас, то нотата автоматично се свързва с онзи глас като финален тон."@bg ;
                     rdfs:label "note finalizes on mode (inferred chain)"@en ,
                                "нота финализира на глас (изведено чрез верига)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#noteIsIsonOfMode
:noteIsIsonOfMode rdf:type owl:ObjectProperty ;
                  rdfs:domain :MusicalNote ;
                  rdfs:range :Mode ;
                  owl:propertyChainAxiom ( :hasParalagiaStep
                                           :isIsonOfMode
                                         ) ;
                  rdfs:comment "Изведено свойство чрез верига от две свойства: стъпката на нотата и гласът, за който тази стъпка служи за исон. Ако нота принадлежи към стъпка, която се ползва като исон (бурдон) за даден глас, то нотата автоматично е исонен тон за онзи глас."@bg ;
                  rdfs:label "note is ison for mode (inferred chain)"@en ,
                             "нота е исон на глас (изведено чрез верига)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#occursInLiturgy
:occursInLiturgy rdf:type owl:ObjectProperty ;
                 rdfs:domain :MusicalWork ;
                 rdfs:range :LiturgicalService ;
                 rdfs:comment "Links a work to the liturgical context where it is sung."@en ;
                 rdfs:label "occurs in liturgy"@en ,
                            "среща се в литургия"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#originatesFrom
:originatesFrom rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Tradition ;
                rdfs:range :Location ;
                rdfs:comment "Links a tradition to its geographical or cultural origin."@en ;
                rdfs:label "originates from"@en ,
                           "произхожда от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#partOfCycle
:partOfCycle rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :LiturgicalCycle ;
             rdfs:comment "Links a work to the larger liturgical cycle it belongs to."@en ;
             rdfs:label "part of cycle"@en ,
                        "е част от цикъл"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#patronedBy
:patronedBy rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Person ;
            rdfs:range :Person ;
            rdfs:comment "Links a composer or musician to their patron."@en ;
            rdfs:label "patroned by"@en ,
                       "покровителстван от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#performedBy
:performedBy rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :Ensemble ;
             rdfs:comment "Links a work to the ensemble or soloist performing it."@en ;
             rdfs:label "performed by"@en ,
                        "изпълнено от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#performedRegularly
:performedRegularly rdf:type owl:ObjectProperty ;
                    rdfs:domain :MusicalWork ;
                    rdfs:range :LiturgicalService ;
                    rdfs:comment "Links a work to the liturgical service where it is regularly performed."@en ,
                                 "Свързва химн с честотата на неговото изпълнение (ежедневно, седмично и т.н.)."@bg ;
                    rdfs:label "performed regularly"@en ,
                               "изпълнява се редовно"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#performsWith
:performsWith rdf:type owl:ObjectProperty ,
                       owl:SymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :Person ;
              rdfs:range :Person ;
              rdfs:comment "Links musicians who regularly perform together in ensemble."@en ;
              rdfs:label "performs with"@en ,
                         "изпълнява заедно с"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#plagalCounterpart
:plagalCounterpart rdf:type owl:ObjectProperty ,
                            owl:SymmetricProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain :MusicalWork ;
                   rdfs:range :MusicalWork ;
                   rdfs:comment "Links a work to its plagal-mode variant."@en ,
                                "Свързва автентичен глас с неговия плагален двойник."@bg ;
                   rdfs:label "plagal counterpart"@en ,
                              "плагален двойник"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#plagalOf
:plagalOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :relatedMode ;
          rdf:type owl:FunctionalProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :Mode ;
          rdfs:range :Mode ;
          rdfs:comment "Links a plagal mode to its corresponding authentic mode."@en ,
                       "Свързва плагален глас с родния му автентичен глас."@bg ;
          rdfs:label "plagal of"@en ,
                     "е плагален на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#practisedAt
:practisedAt rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Tradition ;
             rdfs:range :Institution ;
             rdfs:comment "Links a tradition to the institution or location where it is practiced."@en ;
             rdfs:label "practised at"@en ,
                        "практикуван в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#precedes
:precedes rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain :HistoricalPeriod ;
          rdfs:range :HistoricalPeriod ;
          rdfs:comment "Указва хронологичната последователност на историческите епохи."@bg ;
          rdfs:label "precedes"@en ,
                     "предхожда"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#precedesNeume
:precedesNeume rdf:type owl:ObjectProperty ;
               rdfs:domain :Neume ;
               rdfs:range :Neume ;
               rdfs:comment "Links a neume to the neume that typically follows it in melodic context."@en ;
               rdfs:label "precedes neume"@en ,
                          "предхожда невма"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#preservedIn
:preservedIn rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Manuscript ;
             rdfs:range :Library ;
             rdfs:comment "Links a manuscript to the library or archive holding it."@en ;
             rdfs:label "preserved in"@en ,
                        "съхранява се в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#publishedIn
:publishedIn rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :Publication ;
             rdfs:comment "Links a modern edition to the publication or journal in which it appears."@en ;
             rdfs:label "published in"@en ,
                        "публикувано в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#recordedBy
:recordedBy rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :MusicalWork ;
            rdfs:range :Ensemble ;
            rdfs:comment "Links a work to ensembles that have recorded it."@en ;
            rdfs:label "recorded by"@en ,
                       "записан от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#recordedIn
:recordedIn rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :MusicalWork ;
            rdfs:range :Manuscript ;
            rdfs:comment "Links a work to the manuscripts that record it."@en ;
            rdfs:label "recorded in"@en ,
                       "записан в"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#recordingBy
:recordingBy rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :MusicalWork ;
             rdfs:range :Recording ;
             rdfs:comment "Links a work to a specific recording made by an ensemble."@en ;
             rdfs:label "recording by"@en ,
                        "запис от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#referencesWork
:referencesWork rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :ScholarlyWork ;
                rdfs:range :MusicalWork ;
                rdfs:comment "Links a scholarly work to the musical or archival sources it examines."@en ;
                rdfs:label "references work"@en ,
                           "препраща към произведение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#relatedMode
:relatedMode rdf:type owl:ObjectProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Mode ;
             rdfs:range :Mode ;
             rdfs:comment "Links two modes that share structural or melodic characteristics."@en ;
             rdfs:label "related mode"@en ,
                        "свързан глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#relatedToMode
:relatedToMode rdf:type owl:ObjectProperty ;
               rdfs:domain :MusicalWork ;
               rdfs:range :Echos ;
               rdfs:comment "Links a work to related echoi (melodic or structural kinship)."@en ,
                            "Свързва произведение или стъпка с родствен глас."@bg ;
               rdfs:label "related to mode"@en ,
                          "свързан с глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#relatesTo
:relatesTo rdf:type owl:ObjectProperty ,
                    owl:SymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Tradition ;
           rdfs:range :Tradition ;
           rdfs:comment "General relationship between traditions or practices."@en ;
           rdfs:label "relates to"@en ,
                      "отнася се до"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#represents
:represents rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Neume ;
            rdfs:range :Interval ;
            owl:propertyDisjointWith :representsStep ;
            rdfs:comment "Links a neume to the interval or melodic gesture it expresses."@en ;
            rdfs:label "represents"@en ,
                       "представя"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#representsStep
:representsStep rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Neume ;
                rdfs:range :ParalagiaStep ;
                rdfs:comment "Links a neume to the Paralagia step it melodically represents."@en ,
                             "Свързва невма със стъпката, която тя мелодично представя (посоката и интервала на движение)."@bg ;
                rdfs:label "represents step"@en ,
                           "αντιπροσωπεύει βήμα"@el ,
                           "представя стъпка"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#representsSyllable
:representsSyllable rdf:type owl:ObjectProperty .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#responsorialPairWith
:responsorialPairWith rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain :MusicalWork ;
                      rdfs:range :MusicalWork ;
                      rdfs:comment "Links two works that form a responsorial (call-and-response) pair in liturgy."@en ,
                                   "Свързва два химна, образуващи отзивна двойка."@bg ;
                      rdfs:label "responsorial pair with"@en ,
                                 "отзивна двойка с"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#setsTextTo
:setsTextTo rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :MusicalWork ;
            rdfs:range :Text ;
            rdfs:comment "Links a musical work to its associated liturgical text or poem."@en ;
            rdfs:label "sets text to"@en ,
                       "поставя текст на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#similarMelodyTo
:similarMelodyTo rdf:type owl:ObjectProperty ,
                          owl:SymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain :MusicalWork ;
                 rdfs:range :MusicalWork ;
                 rdfs:comment "Links works with similar or related melodic contours."@en ,
                              "Указва мелодично сходство между две произведения."@bg ;
                 rdfs:label "similar melody to"@en ,
                            "мелодично сходен с"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#stepNeume
:stepNeume rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :PatternStep ;
           rdfs:range :Neume ;
           rdfs:label "невмата на стъпката"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#studentOf
:studentOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :influencedBy ;
           owl:inverseOf :teacherOf ;
           rdf:type owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Person ;
           rdfs:range :Person ;
           owl:propertyDisjointWith :teacherOf ;
           rdfs:comment "Указва учителско-ученическа връзка между певци/мелодописци."@bg ;
           rdfs:label "student of"@en ,
                      "ученик на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#studiedBy
:studiedBy rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :MusicalWork ;
           rdfs:range :Scholar ;
           rdfs:comment "Links a work to scholars who have written about or analyzed it."@en ;
           rdfs:label "studied by"@en ,
                      "изследвано от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#succeedsNeume
:succeedsNeume rdf:type owl:ObjectProperty ;
               rdfs:domain :Neume ;
               rdfs:range :Neume ;
               rdfs:comment "Links a neume to the neume that typically precedes it."@en ;
               rdfs:label "succeeds neume"@en ,
                          "следва невма"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#successorOf
:successorOf rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain :Person ;
             rdfs:range :Person ;
             rdfs:comment "Links a composer to their predecessor in a tradition."@en ,
                          "Указва музикален или институционален приемник."@bg ;
             rdfs:label "successor of"@en ,
                        "приемник на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#sungInMode
:sungInMode rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Hymn ;
            rdfs:range :Mode ;
            rdfs:comment "Указва в кой глас се пее химнът."@bg ;
            rdfs:label "sung in mode"@en ,
                       "пее се на глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#sungOn
:sungOn rdf:type owl:ObjectProperty ,
                 owl:AsymmetricProperty ,
                 owl:IrreflexiveProperty ;
        rdfs:domain :MusicalWork ;
        rdfs:range :FeastDay ;
        rdfs:comment "Links a work to a specific feast day or liturgical occasion."@en ;
        rdfs:label "sung on"@en ,
                   "пее се на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#teacherOf
:teacherOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :influencedComposer ;
           rdf:type owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Person ;
           rdfs:range :Person ;
           rdfs:comment "Обратното на „ученик на\". Ако X е ученик на Y, тогава Y автоматично се извежда като учител на X от reasoner-а."@bg ;
           rdfs:label "teacher of (inferred inverse)"@en ,
                      "учител на (изведена инверсия)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#trainedBy
:trainedBy rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :studentOf ;
           owl:inverseOf :trainsMusician ;
           rdf:type owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Person ;
           rdfs:range :Person ;
           rdfs:comment "Links a chanter or musician to their primary instructor."@en ;
           rdfs:label "trained by"@en ,
                      "обучен от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#trainsMusician
:trainsMusician rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :teacherOf ;
                rdf:type owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Person ;
                rdfs:range :Person ;
                rdfs:comment "Links a master musician or teacher to their students."@en ;
                rdfs:label "trains musician"@en ,
                           "обучава музикант"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#transliteratedBy
:transliteratedBy rdf:type owl:ObjectProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :MusicalWork ;
                  rdfs:range :Person ;
                  rdfs:comment "Links a neume-notated work to its transliteration into modern notation."@en ;
                  rdfs:label "transliterated by"@en ,
                             "транслитерирано от"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#transmittedVia
:transmittedVia rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :MusicalWork ;
                rdfs:range :EasternOrthodoxTradition ;
                rdfs:comment "Links a work to the tradition(s) through which it was transmitted."@en ,
                             "Указва начина, по който традицията е предадена (устно, ръкопис, печат)."@bg ;
                rdfs:label "transmitted via"@en ,
                           "предаден чрез"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#usesNeume
:usesNeume rdf:type owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :MusicalWork ;
           rdfs:range :Neume ;
           rdfs:comment "Links a musical work to the specific neumes employed in its notation."@en ,
                        "Свързва музикално произведение или фраза с невмата, която се използва в него."@bg ;
           rdfs:label "uses neume"@en ,
                      "χρησιμοποιεί νεύμα"@el ,
                      "използва невма"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#usesScale
:usesScale rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ,
                    owl:AsymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Mode ;
           rdfs:range :Scale ;
           rdfs:comment "Указва гамата (звукореда), характерна за гласа."@bg ;
           rdfs:label "uses scale"@en ,
                      "използва гама"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#variantOf
:variantOf rdf:type owl:ObjectProperty ,
                    owl:SymmetricProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :MusicalWork ;
           rdfs:range :MusicalWork ;
           rdfs:comment "Links a musical work to another with which it shares melodic or textual kinship."@en ,
                        "Посочва, че дадено произведение е вариант на друго."@bg ;
           rdfs:label "variant of"@en ,
                      "вариант на"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#workedAt
:workedAt rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :Person ;
          rdfs:range :Institution ;
          rdfs:comment "Links a musician to an institution where they held a position."@en ;
          rdfs:label "worked at"@en ,
                     "работил в"@bg .


#################################################################
#    Data properties
#################################################################

###  http://www.paralagia.bg/ontology/vizantiiska-muzika#apechemaNote
:apechemaNote rdf:type owl:DatatypeProperty ;
              rdfs:domain :Mode ;
              rdfs:comment "Отклоненията на апихимата по стил, когато изворите ги дават."@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#apechemaSyllables
:apechemaSyllables rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Apechema
                                               :Mode
                                             )
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Оборотът, изпяван преди песнопението, за да установи гласа."@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ascendingPattern
:ascendingPattern rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Mode ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Характерна невматична последователност при възходящо движение в дадения глас."@bg ;
                  rdfs:label "typical ascending movement"@en ,
                             "типично възходящо движение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#byzantineFrequency
:byzantineFrequency rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :frequency ;
                    rdfs:domain :MusicalNote ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "Честотата в Hz на нотата при прилагане на характерните за Втори (хроматичен) или Трети глас микротонални поправки по Хрисантовата теория (отклонения от равномерния строй). За диатоничните гласове съвпада с честота при равномерен строй."@bg ;
                    rdfs:label "Byzantine adjusted frequency (Hz)"@en ,
                               "византийска честота (Hz)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#byzantineOctaveRegister
:byzantineOctaveRegister rdf:type owl:DatatypeProperty ;
                         rdfs:domain :MusicalNote ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Октавното положение в системата: κάτω (долна октава), μέσον (средна октава), υψηλόν (горна октава). По традиция основната певческа октава е средната (μέσον)."@bg ;
                         rdfs:label "Byzantine octave register"@en ,
                                    "Октавно положение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#cadencePattern
:cadencePattern rdf:type owl:DatatypeProperty ;
                rdfs:domain :Mode ;
                rdfs:range xsd:string ;
                rdfs:comment "Типичната невматична последователност, с която завършва мелодия в дадения глас."@bg ;
                rdfs:label "cadence formula (neumatic sequence)"@en ,
                           "кадансова формула (невматична последователност)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#character
:character rdf:type owl:DatatypeProperty ;
           rdfs:domain :Mode ;
           rdfs:range xsd:string ;
           rdfs:comment "Емоционалният и духовен характер на гласа (напр. тържествен, покаятен, радостен)."@bg ;
           rdfs:label "character / ethos"@en ,
                      "характер"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#descendingPattern
:descendingPattern rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Mode ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Характерна невматична последователност при низходящо движение в дадения глас."@bg ;
                   rdfs:label "typical descending movement"@en ,
                              "типично низходящо движение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:label "description"@en ,
                        "описание"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#finalTone
:finalTone rdf:type owl:DatatypeProperty ;
           rdfs:domain :Mode ;
           rdfs:range xsd:string ;
           rdfs:comment "Основният (финален) тон на гласа, върху който завършва мелодията."@bg ;
           rdfs:label "final tone"@en ,
                      "финален тон"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#frequency
:frequency rdf:type owl:DatatypeProperty ;
           rdfs:domain :MusicalElement ;
           rdfs:range xsd:decimal ;
           rdfs:comment "Честотата на нотата в херцове (Hz), изчислена спрямо камертон А4 = 440 Hz."@bg ;
           rdfs:label "frequency (Hz)"@en ,
                      "честота (Hz)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#fullParalagiaName
:fullParalagiaName rdf:type owl:DatatypeProperty ;
                   rdfs:domain :MusicalNote ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Пълното наименование на нотата, включващо сричката и октавното положение (напр. „Νη μέσον\", „Πα κάτω\", „Γα υψηλόν\")."@bg ;
                   rdfs:label "full paralagia name"@en ,
                              "Пълно име"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#intervalSemitones
:intervalSemitones rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Neume ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Приблизителна стойност на интервала в западни полутонове за диатоничния глас. В хроматичните гласове стойностите варират."@bg ;
                   rdfs:label "interval in semitones (Western temperament)"@en ,
                              "интервал в полутонове (западен темперамент)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#intervalValue
:intervalValue rdf:type owl:DatatypeProperty ;
               rdfs:domain :Neume ;
               rdfs:range xsd:integer ;
               rdfs:comment "Мелодичното движение, изразено в дялове (мории): положително = нагоре, отрицателно = надолу."@bg ;
               rdfs:label "interval value (in morae)"@en ,
                          "интервална стойност (в мории)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#isDiatonicNote
:isDiatonicNote rdf:type owl:DatatypeProperty ;
                rdfs:domain :MusicalNote ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Указва дали нотата е диатонична (основна) нота в солфежната скала (true) или хроматичен полутон/случайна нота (false)."@bg ;
                rdfs:label "is diatonic note"@en ,
                           "е основна (диатонична) нота"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#melodicRangeSteps
:melodicRangeSteps rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Mode ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Типичният мелодичен обем на гласа в срички – обикновено октава (8) или малко повече."@bg ;
                   rdfs:label "melodic range (number of steps)"@en ,
                              "мелодичен обем (брой стъпки)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#midiNumber
:midiNumber rdf:type owl:DatatypeProperty ;
            rdfs:domain :MusicalNote ;
            rdfs:range xsd:integer ;
            rdfs:comment "MIDI номер на нотата (0–127). Средното До (C4) = 60."@bg ;
            rdfs:label "MIDI number"@en ,
                       "MIDI номер"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#modeNumber
:modeNumber rdf:type owl:DatatypeProperty ;
            rdfs:domain :Mode ;
            rdfs:range xsd:integer ;
            rdfs:comment "Числото на гласа в осмогласната система (1–8)."@bg ;
            rdfs:label "mode number"@en ,
                       "номер на глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#noteName
:noteName rdf:type owl:DatatypeProperty ;
          rdfs:domain :MusicalNote ;
          rdfs:range xsd:string ;
          rdfs:comment "Международното наименование на нотата (например C#4, D4, A4)."@bg ;
          rdfs:label "note name"@en ,
                     "името на нотата"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#octave
:octave rdf:type owl:DatatypeProperty ;
        rdfs:domain :MusicalNote ;
        rdfs:range xsd:integer ;
        rdfs:comment "Октавата, в която се намира нотата (0 = субконтра октава, 4 = малка октава със средно До)."@bg ;
        rdfs:label "octave"@en ,
                   "октава"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#paralagiasSyllable
:paralagiasSyllable rdf:type owl:DatatypeProperty ;
                    rdfs:domain :MusicalElement ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Сричка (солфежна сричка) по Хрисантовата реформа: Νη, Πα, Βου, Γα, Δη, Κε, Ζω. Използва се за обозначаване на диатоничния тон в осмогласната система."@bg ;
                    rdfs:label "paralagia syllable"@en ,
                               "сричка"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#periodEnd
:periodEnd rdf:type owl:DatatypeProperty ;
           rdfs:domain :HistoricalPeriod ;
           rdfs:range xsd:integer ;
           owl:propertyDisjointWith :periodStart ;
           rdfs:label "period end"@en ,
                      "край на епохата"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#periodStart
:periodStart rdf:type owl:DatatypeProperty ;
             rdfs:domain :HistoricalPeriod ;
             rdfs:range xsd:integer ;
             rdfs:label "period start"@en ,
                        "начало на епохата"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#scaleType
:scaleType rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Mode ;
           rdfs:range xsd:string ;
           rdfs:comment "Родът (γένος) на гласа: диатоничен, мек хроматичен, твърд хроматичен или енхармоничен."@bg ;
           rdfs:label "scale type"@en ,
                      "γένος"@el ,
                      "тип звукоред"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#stepOrder
:stepOrder rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :ParalagiaStep ;
           rdfs:range xsd:integer ;
           rdfs:comment "Позицията на стъпката в скалата (гамата): Νη=1, Πα=2, Βου=3, Γα=4, Δη=5, Κε=6, Ζω=7."@bg ;
           rdfs:label "step order"@en ,
                      "τάξη βήματος"@el ,
                      "пореден номер на стъпката"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#stepPosition
:stepPosition rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :PatternStep ;
              rdfs:range xsd:integer ;
              rdfs:label "място в оборота"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#tetrachordIntervals
:tetrachordIntervals rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Scale ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Трите интервала на тетрахорда изразени в мории (1 тон = 12 мории): напр. „12-10-8\" за диатоничен."@bg ;
                     rdfs:label "tetrachord intervals (in morae)"@en ,
                                "интервали на тетрахорда (в мории)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#yearOfCreation
:yearOfCreation rdf:type owl:DatatypeProperty ;
                rdfs:label "year of creation"@en ,
                           "година на създаване"@bg .


#################################################################
#    Classes
#################################################################

###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Akathistos
:Akathistos rdf:type owl:Class ;
            rdfs:subClassOf :Hymn ;
            owl:disjointWith :Alleluia ,
                             :Antiphon ,
                             :Canon ,
                             :Hirmos ,
                             :Kontakion ,
                             :Prokeimenon ,
                             :Sticheron ,
                             :Troparion ;
            :greekName "Ἀκάθιστος ὕμνος" ;
            rdfs:comment "Особен вид хваления, при което молещите се стоят прави (а-катист = не седящ). Най-известен е Акатистът на Пресвета Богородица."@bg ;
            rdfs:label "Akathistos"@en ,
                       "Акатист"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Akolouthia
:Akolouthia rdf:type owl:Class ;
            owl:equivalentClass :LiturgicalService ;
            rdfs:comment "Akolouthia (ακολουθια) is the Greek term for a liturgical service — equivalent to LiturgicalService."@en ;
            rdfs:label "Akolouthia"@en ,
                       "Акoлутия (певческо последование)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Alleluia
:Alleluia rdf:type owl:Class ;
          rdfs:subClassOf :Hymn ;
          owl:disjointWith :Antiphon ,
                           :Canon ,
                           :Hirmos ,
                           :Kontakion ,
                           :Prokeimenon ,
                           :Sticheron ,
                           :Troparion ;
          :greekName "Ἀλληλούϊα" ;
          rdfs:comment "Хвалебно пеене „Хвалете Бога\" (евр.), изпято преди Евангелието и на определени места в богослужението."@bg ;
          rdfs:label "Alleluia"@en ,
                     "Алилуия"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Antiphon
:Antiphon rdf:type owl:Class ;
          rdfs:subClassOf :Hymn ;
          owl:disjointWith :Canon ,
                           :Hirmos ,
                           :Kontakion ,
                           :Prokeimenon ,
                           :Sticheron ,
                           :Troparion ;
          :greekName "Ἀντίφωνον" ;
          rdfs:comment "Песнопение, пеано редуващо от два певчески лика (десен и ляв хор)."@bg ;
          rdfs:label "Antiphon"@en ,
                     "Антифон"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Apechema
:Apechema rdf:type owl:Class ;
          rdfs:comment "Краткият напев, с който се дава тонът преди пеенето на гласа."@bg ,
                       "Апехема и апихима - дублетни форми" ;
          rdfs:label "Apechema"@en ,
                     "Апихима"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Archive
:Archive rdf:type owl:Class ;
         rdfs:subClassOf :Organization ;
         owl:disjointWith :Institution ,
                          :Library ;
         rdfs:comment "A physical or digital archive holding manuscripts or recordings."@en ;
         rdfs:label "Archive"@en ,
                    "Архив"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#AthoniteTradition
:AthoniteTradition rdf:type owl:Class .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#AuthenticMode
:AuthenticMode rdf:type owl:Class ;
               rdfs:subClassOf :Mode ;
               owl:disjointWith :PlagalMode ;
               :greekName "Κύριος ήχος" ;
               rdfs:comment "Основен (автентичен) глас от осмогласната система. Включва гласове 1, 2, 3 и 4."@bg ;
               rdfs:label "Authentic Mode"@en ,
                          "Автентичен глас"@bg .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :AuthenticMode ;
   owl:annotatedProperty owl:disjointWith ;
   owl:annotatedTarget :PlagalMode ;
   rdfs:comment "Автентичните и плагалните гласове са два несъвместими вида от осмогласната система."@bg
 ] .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#BodyNeume
:BodyNeume rdf:type owl:Class ;
           rdfs:subClassOf :Neume ;
           owl:disjointWith :Martyria ,
                            :Modifier ,
                            :OrnamentalNeume ,
                            :Phthora ,
                            :RhythmicNeume ;
           :greekName "Σώμα" ;
           rdfs:comment "Основна невма, изразяваща мелодичното движение нагоре или надолу с определен брой стъпки."@bg ;
           rdfs:label "Body Neume (Soma)"@en ,
                      "Основна невма (телесна невма)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#BulgarianChantingTradition
:BulgarianChantingTradition rdf:type owl:Class .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#CadentialFormula
:CadentialFormula rdf:type owl:Class ;
                  rdfs:subClassOf :MelodicFormula ;
                  rdfs:comment "последователност, с която завършва мелодична фраза; довежда до финалния тон на гласа."@bg ;
                  rdfs:label "Cadential Formula"@en ,
                             "Φόρμουλα κατακλείδος"@el ,
                             "Кадансова формула"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Canon
:Canon rdf:type owl:Class ;
       rdfs:subClassOf :Hymn ;
       owl:disjointWith :Hirmos ,
                        :Kontakion ,
                        :Prokeimenon ,
                        :Sticheron ,
                        :Troparion ;
       :churchSlavonicName "Канон" ;
       :greekName "Κανών" ;
       rdfs:comment "Сложна литургична поетично-музикална форма, съставена от девет песни (ирмоси и тропари), пеана на Утренята."@bg ;
       rdfs:label "Canon"@en ,
                  "Канон"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ChantStyle
:ChantStyle rdf:type owl:Class ;
            rdfs:label "Chant style"@en ,
                       "Стил на песнопението"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Chanter
:Chanter rdf:type owl:Class ;
         rdfs:subClassOf :Person ;
         owl:disjointWith :Ensemble ;
         :greekName "Ψάλτης" ;
         rdfs:comment "Лице, изпълняващо богослужебни песнопения в православната църква."@bg ;
         rdfs:label "Chanter / Singer"@en ,
                    "Певец"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ChantingSchool
:ChantingSchool rdf:type owl:Class ;
                rdfs:subClassOf :Tradition ;
                owl:disjointWith :Cheironomy ,
                                 :LiturgicalCycle ,
                                 :LiturgicalService ;
                rdfs:comment "Регионална или историческа традиция на певческо изпълнение с характерни особености."@bg ;
                rdfs:label "Chanting School / Tradition"@en ,
                           "Певческа школа"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Cheironomy
:Cheironomy rdf:type owl:Class ;
            rdfs:subClassOf :Tradition ;
            owl:disjointWith :LiturgicalCycle ,
                             :LiturgicalService ;
            :greekName "Χειρονομία" ;
            rdfs:comment "Система от ръкови жестове, с която домести (хормайсторът) указва на певците темпото, ритъма и украшенията."@bg ;
            rdfs:label "Cheironomy (Hand Conducting)"@en ,
                       "Хейрономия"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ChromaticNote
:ChromaticNote rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :MusicalNote
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :isDiatonicNote ;
                                                            owl:hasValue "false"^^xsd:boolean
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :MusicalNote ;
               owl:disjointWith :DiatonicNote ;
               rdfs:comment "Defined class: every MusicalNote with isDiatonicNote=false is automatically classified as a ChromaticNote by the reasoner."@en ,
                            "Нота с хроматична (полутонова) стойност, която не принадлежи към основните стъпки. Reasoner-ът я извежда чрез GCI: МузикалнаНота ∩ (еОсновнаНота стойност false) → ХроматичнаНота."@bg ;
               rdfs:label "Chromatic Note (Accidental)"@en ,
                          "Хроматична нота (полутон)"@bg .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ChromaticNote ;
   owl:annotatedProperty owl:disjointWith ;
   owl:annotatedTarget :DiatonicNote ;
   rdfs:comment "Диатоничните и хроматичните ноти са несъвместими подкласове на МузикалнаНота: нота с еОсновнаНота=true не може да е хроматична и обратното."@bg
 ] .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Compline
:Compline rdf:type owl:Class ;
          rdfs:subClassOf :LiturgicalService ;
          owl:disjointWith :DivineLiturgy ,
                           :Hours ,
                           :Matins ,
                           :Vespers ;
          :greekName "Ἀπόδειπνον" ;
          rdfs:comment "Вечерно богослужение след вечеря, включващо покаятни песнопения."@bg ;
          rdfs:label "Compline (Apodeipnon)"@en ,
                     "Повечерие"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Composer
:Composer rdf:type owl:Class ;
          rdfs:subClassOf :Person ;
          owl:disjointWith :Ensemble ;
          rdfs:comment "A person who creates the MELODY of liturgical music. Distinct from Hymnographer (who writes the text), though historically the same person often did both. A Composer may also be a Hymnographer but this is not always the case."@en ;
          rdfs:label "Composer"@en ,
                     "Съставител на песнопения"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ConstantinopolitanSchool
:ConstantinopolitanSchool rdf:type owl:Class .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#DiatonicNote
:DiatonicNote rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :MusicalNote
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :isDiatonicNote ;
                                                           owl:hasValue "true"^^xsd:boolean
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :MusicalNote ;
              rdfs:comment "Defined class: every MusicalNote with isDiatonicNote=true is automatically classified as a DiatonicNote by the reasoner."@en ,
                           "Нота, принадлежаща към диатоничната солфежна скала (Νη, Πα, Βου, Γα, Δη, Κε, Ζω). Reasoner-ът я извежда автоматично чрез GCI: МузикалнаНота ∩ (еОсновнаНота стойност true) → ДиатоничнаНота."@bg ;
              rdfs:label "Diatonic Note"@en ,
                         "Диатонична нота"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#DiatonicScale
:DiatonicScale rdf:type owl:Class ;
               rdfs:subClassOf :ScaleType ;
               rdfs:comment "Тетрахордът се изгражда с интервали 12-10-8 мории (голяма секунда – голяма секунда – малка секунда). Използва се в Първи, Четвърти, Пети и Осми глас."@bg ;
               rdfs:label "Diatonic Scale"@en ,
                          "Διατονική κλίμαξ"@el ,
                          "Диатоничен звукоред"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#DivineLiturgy
:DivineLiturgy rdf:type owl:Class ;
               rdfs:subClassOf :LiturgicalService ;
               owl:disjointWith :Hours ,
                                :Matins ,
                                :Vespers ;
               :greekName "Θεία Λειτουργία" ;
               rdfs:comment "Основното евхаристийно богослужение на православната църква. Най-разпространени са Литургиите на св. Йоан Златоуст и св. Василий Велики."@bg ;
               rdfs:label "Divine Liturgy"@en ,
                          "Божествена Литургия"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Document
:Document rdf:type owl:Class ;
          owl:disjointWith :Event ,
                           :HistoricalPeriod ,
                           :LiturgicalBook ,
                           :Location ,
                           :MusicalElement ,
                           :NotationSystem ,
                           :Organization ,
                           :Person ,
                           :Tradition ;
          rdfs:comment "A written, printed, or digital resource — manuscript, publication, scholarly work, or source text."@en ;
          rdfs:label "Document"@en ,
                     "Документ"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Domestikos
:Domestikos rdf:type owl:Class ;
            rdfs:subClassOf :Chanter ;
            owl:disjointWith :Protopsaltis ;
            :greekName "Δομέστικος" ;
            rdfs:comment "Ръководител на певческия хор (хор), указващ темпото и изпълнението чрез хейрономия."@bg ;
            rdfs:label "Domestikos (Choir Director)"@en ,
                       "Доместик"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#EarlyByzantineNotation
:EarlyByzantineNotation rdf:type owl:Class ;
                        rdfs:subClassOf :NotationSystem ;
                        owl:disjointWith :MiddleByzantineNotation ,
                                         :NewAnalyticalNotation ;
                        rdfs:comment "Нотационна система, използвана от IX до XII век. Включва Куаленова, Шартрска и Архаична нотации."@bg ;
                        rdfs:label "Early Byzantine Notation"@en ,
                                   "Ранновизантийска нотация"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#EasternOrthodoxTradition
:EasternOrthodoxTradition rdf:type owl:Class .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Echos
:Echos rdf:type owl:Class ;
       owl:equivalentClass :Mode ;
       rdfs:comment "Echos (ηχος) is the Greek term for Mode — equivalent classes."@en ;
       rdfs:label "Echos"@en ,
                  "Глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#EnharmonicScale
:EnharmonicScale rdf:type owl:Class ;
                 rdfs:subClassOf :ScaleType ;
                 rdfs:comment "Тетрахордът: 12-12-6 мории (голяма секунда – голяма секунда – малка секунда). Среща се при Трети и Седми глас."@bg ;
                 rdfs:label "Enharmonic Scale"@en ,
                            "Εναρμόνιος κλίμαξ"@el ,
                            "Енармоничен звукоред"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Ensemble
:Ensemble rdf:type owl:Class ;
          rdfs:subClassOf :Person ;
          owl:disjointWith :Hymnographer ,
                           :Saint ,
                           :Scholar ;
          rdfs:comment "A group of chanters or musicians performing together."@en ;
          rdfs:label "Ensemble"@en ,
                     "Певческа група"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#EthosQuality
:EthosQuality rdf:type owl:Class ;
              rdfs:subClassOf :MusicalElement ;
              owl:disjointWith :Interval ,
                               :Melisma ,
                               :Mode ,
                               :MusicalNote ,
                               :MusicalWork ,
                               :Neume ,
                               :ParalagiaStep ,
                               :Scale ;
              rdfs:comment "The spiritual or emotional quality (ethos) associated with a mode or hymn."@en ;
              rdfs:label "Ethos Quality"@en ,
                         "Нравствено въздействие"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Event
:Event rdf:type owl:Class ;
       owl:disjointWith :HistoricalPeriod ,
                        :LiturgicalBook ,
                        :Location ,
                        :MusicalElement ,
                        :NotationSystem ,
                        :Organization ,
                        :Person ,
                        :Tradition ;
       rdfs:comment "A temporal occurrence such as a liturgical performance or recording session."@en ;
       rdfs:label "Event"@en ,
                  "Събитие"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#FeastDay
:FeastDay rdf:type owl:Class ;
          rdfs:subClassOf :LiturgicalCycle ;
          rdfs:comment "A liturgical feast day in the Orthodox calendar."@en ;
          rdfs:label "Feast Day"@en ,
                     "Църковен празник"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#HardChromaticScale
:HardChromaticScale rdf:type owl:Class ;
                    rdfs:subClassOf :ScaleType ;
                    rdfs:comment "Тетрахордът: 6-20-4 мории. По-рядко употребяван; среща се в специални случаи при Седми глас."@bg ;
                    rdfs:label "Hard Chromatic Scale"@en ,
                               "Σκληρά χρωματική κλίμαξ"@el ,
                               "Твърд хроматичен звукоред"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Hirmos
:Hirmos rdf:type owl:Class ;
        rdfs:subClassOf :Hymn ;
        owl:disjointWith :Kontakion ,
                         :Prokeimenon ,
                         :Sticheron ,
                         :Troparion ;
        :churchSlavonicName "Ирмос" ;
        :greekName "Εἱρμός" ;
        rdfs:comment "Начална песен на всяка от деветте песни на канона, която задава мелодичния и метрически образец за последващите тропари."@bg ;
        rdfs:label "Hirmos (Heirmos)"@en ,
                   "Ирмос"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#HistoricalPeriod
:HistoricalPeriod rdf:type owl:Class ;
                  owl:disjointWith :LiturgicalBook ,
                                   :Location ,
                                   :MusicalElement ,
                                   :NotationSystem ,
                                   :Organization ,
                                   :Person ,
                                   :Tradition ;
                  rdfs:comment "Период от историческото развитие на православната певческа традиция."@bg ;
                  rdfs:label "Historical Period"@en ,
                             "Историческа епоха"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Hours
:Hours rdf:type owl:Class ;
       rdfs:subClassOf :LiturgicalService ;
       owl:disjointWith :Matins ,
                        :Vespers ;
       :greekName "Ὧραι" ;
       rdfs:comment "Кратки богослужения: Първи, Трети, Шести и Девети час, включващи псалми и тропари."@bg ;
       rdfs:label "Hours (Little Hours)"@en ,
                  "Часове"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Hymn
:Hymn rdf:type owl:Class ;
      rdfs:subClassOf :MusicalWork ;
      :greekName "Ύμνος" ;
      rdfs:comment "Богослужебна песнопойна творба от репертоара на православното богослужение."@bg ;
      rdfs:label "Hymn"@en ,
                 "Химн"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Hymnographer
:Hymnographer rdf:type owl:Class ;
              rdfs:subClassOf :Person ;
              :greekName "Μελωδός" ;
              rdfs:comment "A Hymnographer writes the poetic TEXT of liturgical hymns. Distinct from Composer (who sets the melody), though historically the same person often did both. The classes overlap without being equivalent."@en ,
                           "Автор на богослужебни химни и мелодии в православната традиция."@bg ;
              rdfs:label "Hymnographer / Melodist"@en ,
                         "Мелодописец"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#InitialFormula
:InitialFormula rdf:type owl:Class ;
                rdfs:subClassOf :MelodicFormula ;
                rdfs:comment "Характерна невматична последователност, с която започва мелодия в дадения глас."@bg ;
                rdfs:label "Initial Formula (incipit)"@en ,
                           "Φόρμουλα απαρχής"@el ,
                           "Начална формула (иниций)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Institution
:Institution rdf:type owl:Class ;
             rdfs:subClassOf :Organization ;
             owl:disjointWith :Library ;
             rdfs:comment "A church, monastery, or institution associated with a chanting tradition."@en ;
             rdfs:label "Institution"@en ,
                        "Учреждение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Interval
:Interval rdf:type owl:Class ;
          rdfs:subClassOf :MusicalElement ;
          owl:disjointWith :Melisma ,
                           :Mode ,
                           :MusicalNote ,
                           :MusicalWork ,
                           :Neume ,
                           :ParalagiaStep ,
                           :Scale ;
          rdfs:comment "Разстоянието между два тона, измерено в равни дялове (72 дяла в октавата по Хрисант)."@bg ;
          rdfs:label "Interval"@en ,
                     "Интервал"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Irmologion
:Irmologion rdf:type owl:Class ;
            rdfs:subClassOf :LiturgicalBook ;
            owl:disjointWith :Menaion ,
                             :Octoechos ,
                             :Pentekostarion ,
                             :Triodion ;
            :greekName "Εἱρμολόγιον" ;
            rdfs:comment "Певческа книга, съдържаща ирмосите на всички канони наредени по гласове."@bg ;
            rdfs:label "Irmologion"@en ,
                       "Ирмологион"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Ison
:Ison rdf:type owl:Class ;
      rdfs:subClassOf :BodyNeume ,
                      :MusicalElement ;
      :greekName "Ἴσον" ;
      rdfs:comment "Unison — stays on the same pitch."@en ,
                   "Исон – повторен тон; без движение нагоре или надолу."@bg ,
                   "Продължителен задържан тон (бурдон), пят от вторите певци, докато главният псалт изпълнява мелодията. Характерна черта на православното пеене."@bg ;
      rdfs:label "Ison (Drone)"@en ,
                 "Исон (бурдон)"@bg ,
                 "Ἴσον"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Kontakion
:Kontakion rdf:type owl:Class ;
           rdfs:subClassOf :Hymn ;
           owl:disjointWith :Prokeimenon ,
                            :Sticheron ,
                            :Troparion ;
           :churchSlavonicName "Кондак" ;
           :greekName "Κοντάκιον" ;
           rdfs:comment "Кратко богослужебно песнопение, обобщаващо темата на празника. Исторически е бил по-дълга поетична проповед (св. Роман Сладкопевец)."@bg ;
           rdfs:label "Kontakion"@en ,
                      "Кондак"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Library
:Library rdf:type owl:Class ;
         rdfs:subClassOf :Organization ;
         rdfs:comment "A library holding liturgical manuscripts or books."@en ;
         rdfs:label "Library"@en ,
                    "Библиотека"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#LiturgicalBook
:LiturgicalBook rdf:type owl:Class ;
                owl:disjointWith :Location ,
                                 :MusicalElement ,
                                 :NotationSystem ,
                                 :Organization ,
                                 :Person ,
                                 :Tradition ;
                rdfs:comment "Сборник с химни за определено богослужение или период от църковната година."@bg ;
                rdfs:label "Liturgical Music Book"@en ,
                           "Певческа книга"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#LiturgicalCycle
:LiturgicalCycle rdf:type owl:Class ;
                 rdfs:subClassOf :Tradition ;
                 owl:disjointWith :LiturgicalService ;
                 rdfs:comment "A cycle of liturgical services, e.g. the weekly or yearly cycle."@en ;
                 rdfs:label "Liturgical Cycle"@en ,
                            "Богослужебен кръг"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#LiturgicalService
:LiturgicalService rdf:type owl:Class ;
                   owl:equivalentClass :Service ;
                   rdfs:subClassOf :Tradition ,
                                   [ rdf:type owl:Class ;
                                     owl:unionOf ( :Compline
                                                   :DivineLiturgy
                                                   :Hours
                                                   :Matins
                                                   :Vespers
                                                 )
                                   ] ;
                   :greekName "Ἀκολουθία" ;
                   rdfs:comment "Православно богослужение, в което участват певци и/или хор. Включва различни видове молебни и служби."@bg ;
                   rdfs:label "Liturgical Service"@en ,
                              "Богослужение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Location
:Location rdf:type owl:Class ;
          owl:disjointWith :MusicalElement ,
                           :NotationSystem ,
                           :Organization ,
                           :Person ,
                           :Tradition ;
          rdfs:comment "A geographical location associated with a tradition or manuscript."@en ;
          rdfs:label "Location"@en ,
                     "Място"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Manuscript
:Manuscript rdf:type owl:Class ;
            owl:equivalentClass :ManuscriptSource ;
            rdfs:subClassOf :Document ;
            owl:disjointWith :Publication ,
                             :ScholarlyWork ,
                             :Source ,
                             :Text ;
            rdfs:comment "A handwritten liturgical book containing hymns in neumatic notation."@en ,
                         "Ръкописна певческа книга, съдържаща химни в невматична нотация."@bg ;
            rdfs:label "Manuscript"@en ,
                       "Ръкопис"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ManuscriptSource
:ManuscriptSource rdf:type owl:Class ;
                  rdfs:subClassOf :Document ;
                  owl:disjointWith :Publication ,
                                   :ScholarlyWork ,
                                   :Source ,
                                   :Text ;
                  rdfs:comment "A source manuscript used as the basis for a modern edition — equivalent to Manuscript."@en ;
                  rdfs:label "Manuscript Source"@en ,
                             "Ръкописен извор"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Martyria
:Martyria rdf:type owl:Class ;
          rdfs:subClassOf :Neume ;
          owl:disjointWith :Modifier ,
                           :OrnamentalNeume ,
                           :Phthora ,
                           :RhythmicNeume ;
          :greekName "Μαρτυρία" ;
          rdfs:comment "Знак за гласов ключ, указващ началния глас и тон на химна. Поставя се в началото на мелодията."@bg ;
          rdfs:label "Martyria (Modal Signature)"@en ,
                     "Мартирия"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Matins
:Matins rdf:type owl:Class ;
        rdfs:subClassOf :LiturgicalService ;
        owl:disjointWith :Vespers ;
        :greekName "Ὄρθρος" ;
        rdfs:comment "Сутрешно богослужение, включващо канони, стихири, полиелей и хвалитни стихири."@bg ;
        rdfs:label "Matins (Orthros)"@en ,
                   "Утреня"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Melisma
:Melisma rdf:type owl:Class ;
         rdfs:subClassOf :MusicalElement ;
         owl:disjointWith :Mode ,
                          :MusicalNote ,
                          :MusicalWork ,
                          :Neume ,
                          :ParalagiaStep ,
                          :Scale ;
         :greekName "Μέλισμα" ;
         rdfs:comment "Пеене на няколко ноти върху една сричка – характерна черта на украсения (калофоничен) стил."@bg ;
         rdfs:label "Melisma"@en ,
                    "Мелизма"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#MelodicFormula
:MelodicFormula rdf:type owl:Class ;
                rdfs:subClassOf :MusicalElement ;
                rdfs:comment "Кратка характерна невматична последователност, типична за даден глас. Включва каданси, иниции и централни обороти."@bg ;
                rdfs:label "Melodic Formula"@en ,
                           "Μελωδική φόρμουλα"@el ,
                           "Мелодична формула"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Menaion
:Menaion rdf:type owl:Class ;
         rdfs:subClassOf :LiturgicalBook ;
         owl:disjointWith :Octoechos ,
                          :Pentekostarion ,
                          :Triodion ;
         :greekName "Μηναῖον" ;
         rdfs:comment "Певческа книга, съдържаща химните за всеки месец и съответните светци (12 тома)."@bg ;
         rdfs:label "Menaion"@en ,
                    "Минея"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#MiddleByzantineNotation
:MiddleByzantineNotation rdf:type owl:Class ;
                         rdfs:subClassOf :NotationSystem ;
                         owl:disjointWith :NewAnalyticalNotation ;
                         rdfs:comment "Нотационна система от XII до XIX век, станала стандарт за православната музика. Невмите имат точно интервално значение."@bg ;
                         rdfs:label "Middle Byzantine Notation"@en ,
                                    "Средновизантийска нотация"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode
:Mode rdf:type owl:Class ;
      rdfs:subClassOf :MusicalElement ,
                      [ rdf:type owl:Class ;
                        owl:unionOf ( :AuthenticMode
                                      :PlagalMode
                                    )
                      ] ;
      owl:disjointWith :MusicalNote ,
                       :MusicalWork ,
                       :Neume ,
                       :ParalagiaStep ,
                       :Scale ;
      :greekName "Ηχος" ;
      rdfs:comment "Един от осемте гласа (ηχοι) на осмогласната система. Всеки глас притежава характерна мелодична формула, финален тон и емоционален характер."@bg ;
      rdfs:label "Mode (Echos)"@en ,
                 "Глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Modifier
:Modifier rdf:type owl:Class ;
          rdfs:subClassOf :Neume ;
          owl:disjointWith :OrnamentalNeume ,
                           :Phthora ,
                           :RhythmicNeume ;
          rdfs:comment "A neume or sign that modifies the pitch or rhythm of another neume."@en ;
          rdfs:label "Modifier"@en ,
                     "Изменителен знак"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#MusicalElement
:MusicalElement rdf:type owl:Class ;
                owl:disjointWith :NotationSystem ,
                                 :Organization ,
                                 :Person ,
                                 :Tradition ;
                rdfs:comment "Основен клас за всички елементи на византийската православна музика."@bg ;
                rdfs:label "Musical Element"@en ,
                           "Музикален елемент"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#MusicalNote
:MusicalNote rdf:type owl:Class ;
             rdfs:subClassOf :MusicalElement ,
                             [ rdf:type owl:Class ;
                               owl:unionOf ( :ChromaticNote
                                             :DiatonicNote
                                           )
                             ] ;
             owl:disjointWith :MusicalWork ,
                              :Neume ,
                              :ParalagiaStep ,
                              :Scale ;
             owl:hasKey ( :midiNumber
                        ) ;
             rdfs:comment "Ключово свойство: два индивида от МузикалнаНота с еднакъв мидиНомер са идентични. Reasoner-ът автоматично ги обединява."@bg ,
                          "Музикален тон с точна честота, MIDI номер и октава. Обхваща всички ноти от стандартното пиано (A0 до C8, MIDI 21–108), включвайки диапазона на 72-клавишна MIDI клавиатура."@bg ;
             rdfs:label "Musical Note"@en ,
                        "Музикална нота"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#MusicalWork
:MusicalWork rdf:type owl:Class ;
             rdfs:subClassOf :MusicalElement ;
             owl:disjointWith :Neume ,
                              :ParalagiaStep ,
                              :Scale ;
             rdfs:comment "A distinct musical work or composition in the Byzantine tradition."@en ;
             rdfs:label "Musical Work"@en ,
                        "Музикално произведение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Neume
:Neume rdf:type owl:Class ;
       rdfs:subClassOf :MusicalElement ,
                       [ rdf:type owl:Class ;
                         owl:unionOf ( :BodyNeume
                                       :Martyria
                                       :Modifier
                                       :OrnamentalNeume
                                       :Phthora
                                       :RhythmicNeume
                                     )
                       ] ;
       owl:disjointWith :ParalagiaStep ,
                        :Scale ;
       :greekName "Νεύμα" ;
       rdfs:comment "Знак от невматичната нотация на византийската музика. Невмите указват мелодичното движение, ритъма и украшенията."@bg ;
       rdfs:label "Neume"@en ,
                  "Невма"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#NewAnalyticalNotation
:NewAnalyticalNotation rdf:type owl:Class ;
                       rdfs:subClassOf :NotationSystem ;
                       rdfs:comment "Реформирана нотационна система, въведена от Хрисант Мадитски, Григорий Протопсалт и Хурмузий Харторилакс през 1814 г. Използва се в съвременната практика."@bg ;
                       rdfs:label "New Analytical Notation (Chrysanthine Reform)"@en ,
                                  "Нова аналитична нотация (Хурмузиева реформа)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#NotationSystem
:NotationSystem rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Class ;
                                  owl:unionOf ( :EarlyByzantineNotation
                                                :MiddleByzantineNotation
                                                :NewAnalyticalNotation
                                              )
                                ] ;
                owl:disjointWith :Organization ,
                                 :Person ,
                                 :Tradition ;
                rdfs:comment "Система за записване на византийска музика с помощта на невми."@bg ;
                rdfs:label "Notation System"@en ,
                           "Нотационна система"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Octoechos
:Octoechos rdf:type owl:Class ;
           rdfs:subClassOf :LiturgicalBook ;
           owl:disjointWith :Pentekostarion ,
                            :Triodion ;
           :greekName "Ὀκτώηχος" ;
           rdfs:comment "„Осмогласник\" – певческа книга, организирана по осемте гласа. Включва служби за всеки ден от седмицата в осемте гласа. Съставена от св. Йоан Дамаскин."@bg ;
           rdfs:label "Octoechos"@en ,
                      "Октоих"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Organization
:Organization rdf:type owl:Class ;
              owl:disjointWith :Person ,
                               :Tradition ;
              rdfs:comment "An institution, archive, library, or other organization related to Byzantine music."@en ;
              rdfs:label "Organization"@en ,
                         "Организация"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#OrnamentalNeume
:OrnamentalNeume rdf:type owl:Class ;
                 rdfs:subClassOf :Neume ;
                 owl:disjointWith :Phthora ,
                                  :RhythmicNeume ;
                 :greekName "Πνεύμα" ;
                 rdfs:comment "Невма, обозначаваща мелодично украшение като трел, портаменто или група от малки ноти."@bg ;
                 rdfs:label "Ornamental Neume (Pneuma)"@en ,
                            "Украсителна невма (πνεύμα)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ParalagiaStep
:ParalagiaStep rdf:type owl:Class ;
               rdfs:subClassOf :MusicalElement ;
               owl:disjointWith :Scale ;
               owl:hasKey ( :paralagiasSyllable
                          ) ;
               :greekName "Φωνή παραλλαγής" ;
               rdfs:comment "One of the seven steps of the Byzantine Paralagia (solfege) scale: Ni, Pa, Vu, Ga, Di, Ke, Zo."@en ,
                            "Една от седемте стъпки на солфежната скала в православното византийско пеене по реформата на Хрисант Мадитски (1814): Νη, Πα, Βου, Γα, Δη, Κε, Ζω. Паралагията е метод за учене и изпяване на мелодии по назоваване на стъпките."@bg ;
               rdfs:label "Paralagia Step (Byzantine Scale Degree)"@en ,
                          "Стъпка"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#PatternStep
:PatternStep rdf:type owl:Class ;
             rdfs:comment "Едно място в оборота: коя невма и коя поред е тя."@bg ;
             rdfs:label "Pattern step"@en ,
                        "Стъпка в оборот"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Pentekostarion
:Pentekostarion rdf:type owl:Class ;
                rdfs:subClassOf :LiturgicalBook ;
                owl:disjointWith :Triodion ;
                :greekName "Πεντηκοστάριον" ;
                rdfs:comment "Певческа книга за периода от Пасха до Неделята на Всички светии (50 дни)."@bg ;
                rdfs:label "Pentekostarion"@en ,
                           "Пентикостар"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Performance
:Performance rdf:type owl:Class ;
             rdfs:subClassOf :Event ;
             owl:disjointWith :Recording ;
             rdfs:comment "A liturgical performance or chanting event."@en ;
             rdfs:label "Performance"@en ,
                        "Изпълнение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Person
:Person rdf:type owl:Class ;
        owl:disjointWith :Tradition ;
        rdfs:label "Person"@en ,
                   "Личност"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Phthora
:Phthora rdf:type owl:Class ;
         rdfs:subClassOf :Neume ;
         owl:disjointWith :RhythmicNeume ;
         :greekName "Φθορά" ;
         rdfs:comment "Специален знак за промяна на гласа в средата на химна или за обозначаване на хроматична промяна."@bg ;
         rdfs:label "Phthora (Modal Signature)"@en ,
                    "Фтора"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#PlagalMode
:PlagalMode rdf:type owl:Class ;
            rdfs:subClassOf :Mode ;
            :greekName "Πλάγιος ήχος" ;
            rdfs:comment "Производен (плагален) глас от осмогласната система. Включва гласове 5 (πλ. α΄), 6 (πλ. β΄), 7 (βαρύς) и 8 (πλ. δ΄)."@bg ;
            rdfs:label "Plagal Mode"@en ,
                       "Плагален глас"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Prokeimenon
:Prokeimenon rdf:type owl:Class ;
             rdfs:subClassOf :Hymn ;
             owl:disjointWith :Sticheron ,
                              :Troparion ;
             :greekName "Προκείμενον" ;
             rdfs:comment "Стих от псалм, пеян преди четенето на апостолско или пророческо четиво."@bg ;
             rdfs:label "Prokeimenon"@en ,
                        "Прокимен"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Protopsaltis
:Protopsaltis rdf:type owl:Class ;
              rdfs:subClassOf :Chanter ;
              :greekName "Πρωτοψάλτης" ;
              rdfs:comment "Главен певец (първи псалт) на дясното певническо място в катедралния храм на Константинопол."@bg ;
              rdfs:label "Protopsaltis (Head Chanter)"@en ,
                         "Протопсалт"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Publication
:Publication rdf:type owl:Class ;
             rdfs:subClassOf :Document ;
             owl:disjointWith :ScholarlyWork ,
                              :Source ,
                              :Text ;
             rdfs:comment "A published edition or scholarly publication of Byzantine music."@en ;
             rdfs:label "Publication"@en ,
                        "Издание"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Recording
:Recording rdf:type owl:Class ;
           rdfs:subClassOf :Event ;
           rdfs:comment "An audio or video recording of Byzantine chant."@en ;
           rdfs:label "Recording"@en ,
                      "Звукозапис"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#RhythmicNeume
:RhythmicNeume rdf:type owl:Class ;
               rdfs:subClassOf :Neume ;
               :greekName "Χρόνος" ;
               rdfs:comment "Невма, обозначаваща ритмичната стойност и продължителността на тона."@bg ;
               rdfs:label "Rhythmic Neume (Chronos)"@en ,
                          "Ритмична невма (χρόνος)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Saint
:Saint rdf:type owl:Class ;
       rdfs:subClassOf :Person ;
       rdfs:comment "An Orthodox Christian saint venerated in the liturgical calendar."@en ;
       rdfs:label "Saint"@en ,
                  "Светец"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Scale
:Scale rdf:type owl:Class ;
       rdfs:subClassOf :MusicalElement ;
       :greekName "Τετράχορδον" ;
       rdfs:comment "Последователност от тонове, изграждаща мелодичния основен материал на гласа. Изгражда се от тетрахорди."@bg ;
       rdfs:label "Scale (Tetrachord)"@en ,
                  "Гама (звукоред)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ScaleType
:ScaleType rdf:type owl:Class ;
           rdfs:subClassOf :Scale ;
           rdfs:comment "Родът (γένος) на звукореда: определя разпределението на интервалите в тетрахорда."@bg ;
           rdfs:label "Scale Type (genus)"@en ,
                      "Γένος"@el ,
                      "Тип звукоред (γένος)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Scholar
:Scholar rdf:type owl:Class ;
         rdfs:subClassOf :Person ;
         rdfs:comment "A musicologist or scholar specialising in Byzantine music."@en ;
         rdfs:label "Scholar"@en ,
                    "Учен"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ScholarlyWork
:ScholarlyWork rdf:type owl:Class ;
               rdfs:subClassOf :Document ;
               owl:disjointWith :Source ,
                                :Text ;
               rdfs:comment "A scholarly article, book, or thesis on Byzantine music."@en ;
               rdfs:label "Scholarly Work"@en ,
                          "Научен труд"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Service
:Service rdf:type owl:Class ;
         rdfs:comment "Service and LiturgicalService denote the same concept."@en ;
         rdfs:label "Service"@en ,
                    "Богослужение"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#SoftChromaticScale
:SoftChromaticScale rdf:type owl:Class ;
                    rdfs:subClassOf :ScaleType ;
                    rdfs:comment "Тетрахордът: 8-14-8 мории (малка секунда – увеличена секунда – малка секунда). Използва се в Втори и Шести глас."@bg ;
                    rdfs:label "Soft Chromatic Scale"@en ,
                               "Μαλακή χρωματική κλίμαξ"@el ,
                               "Мек хроматичен звукоред"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Source
:Source rdf:type owl:Class ;
        rdfs:subClassOf :Document ;
        owl:disjointWith :Text ;
        rdfs:comment "A primary or secondary source document or manuscript."@en ;
        rdfs:label "Source"@en ,
                   "Извор"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Sticheron
:Sticheron rdf:type owl:Class ;
           rdfs:subClassOf :Hymn ;
           owl:disjointWith :Troparion ;
           :churchSlavonicName "Стихира" ;
           :greekName "Στιχηρόν" ;
           rdfs:comment "Богослужебно песнопение, пеено след стих от псалм. Може да е на „Господи воззвах\", „стиховна\" или „хвалитна\"."@bg ;
           rdfs:label "Sticheron"@en ,
                      "Стихира"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Text
:Text rdf:type owl:Class ;
      rdfs:subClassOf :Document ;
      rdfs:comment "The textual content of a hymn or liturgical poem."@en ;
      rdfs:label "Text"@en ,
                 "Текст"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Tradition
:Tradition rdf:type owl:Class ;
           rdfs:comment "A liturgical, chanting, or musical tradition within Orthodox Christianity."@en ;
           rdfs:label "Tradition"@en ,
                      "Традиция"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Triodion
:Triodion rdf:type owl:Class ;
          rdfs:subClassOf :LiturgicalBook ;
          :greekName "Τριῴδιον" ;
          rdfs:comment "Певческа книга за Великопостния и Страстния период (от Митарева неделя до Велика събота)."@bg ;
          rdfs:label "Triodion"@en ,
                     "Триод"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Troparion
:Troparion rdf:type owl:Class ;
           rdfs:subClassOf :Hymn ;
           :churchSlavonicName "Тропарь" ;
           :greekName "Τροπάριον" ;
           rdfs:comment "Кратко богослужебно песнопение, посветено на светец или празник. Основна литургична форма в православното богослужение."@bg ;
           rdfs:label "Troparion"@en ,
                      "Тропар"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Vespers
:Vespers rdf:type owl:Class ;
         rdfs:subClassOf :LiturgicalService ;
         :greekName "Ἑσπερινός" ;
         rdfs:comment "Вечерно богослужение в православната традиция, в което се пеят стихири на „Господи воззвах\", прокимен, лития и стиховни."@bg ;
         rdfs:label "Vespers"@en ,
                    "Вечерня"@bg .


