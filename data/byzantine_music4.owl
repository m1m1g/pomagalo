         :hasImageData "images/sign_chamili.png" ;
         rdfs:comment "Four steps down — large descent."@en ,
                      "Хамили – голям низходящ скок с четири стъпки (−4)."@bg ,
                      "Хамили — четири степени надолу."@bg ;
         rdfs:label "Chamili"@en ,
                    "Χαμηλή"@el ,
                    "Хамили"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ChourmouziosChartophylax
:ChourmouziosChartophylax rdf:type owl:NamedIndividual ,
                                   :Chanter ;
                          :belongsToSchool :ConstantinopolitanSchool ;
                          :flourishedDuring :NeoByzantinePeriod ;
                          :birthYear 1770 ;
                          :deathYear 1840 ;
                          rdfs:comment "Chourmouzios Chartophylax. Third reformer of notation in 1814. Transcribed hundreds of manuscripts."@en ,
                                       "Хурмузий Хартофилакс – третият реформатор на нотацията (1814 г.); архивирал старите ръкописи."@bg ;
                          rdfs:label "Chourmouzios Chartophylax"@en ,
                                     "Χουρμούζιος Χαρτοφύλαξ"@el ,
                                     "Хурмузий Хартофилакс (ок. 1770–1840)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#ChrysanthosOfMadytos
:ChrysanthosOfMadytos rdf:type owl:NamedIndividual ,
                               :Chanter ;
                      :belongsToSchool :ConstantinopolitanSchool ;
                      :collaboratedWith :ChourmouziosChartophylax ,
                                        :GregoriusProtopsaltis ;
                      :contemporaryOf :ChourmouziosChartophylax ,
                                      :GregoriusProtopsaltis ;
                      :flourishedDuring :NeoByzantinePeriod ;
                      :birthYear 1770 ;
                      :deathYear 1846 ;
                      rdfs:comment "Chrysanthos of Madytos. Reformed Byzantine notation in 1814 with Gregorios and Chourmouzios."@en ,
                                   "Хрисант Мадитски – един от тримата реформатори на византийската нотация (1814 г.)."@bg ;
                      rdfs:label "Chrysanthos Of Madytos"@en ,
                                 "Χρύσανθος ὁ ἐκ Μαδύτων"@el ,
                                 "Хрисант Мадитски (ок. 1770–1846)"@bg .


