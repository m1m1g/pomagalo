###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Gorgon
:Gorgon rdf:type owl:NamedIndividual ,
                 :RhythmicNeume ;
        :hasImageData "images/sign_gorgon.png" ;
        rdfs:comment "Halves the duration — accelerates the tempo."@en ,
                     "Горгон – хронос белег за ускоряване; скъсява стойността на тона с половина."@bg ;
        rdfs:label "Gorgon"@en ,
                   "Γοργόν"@el ,
                   "Горгон (ускорение)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#GregoriusProtopsaltis
:GregoriusProtopsaltis rdf:type owl:NamedIndividual ,
                                :Chanter ;
                       :belongsToSchool :ConstantinopolitanSchool ;
                       :collaboratedWith :ChourmouziosChartophylax ;
                       :contemporaryOf :ChourmouziosChartophylax ;
                       :flourishedDuring :NeoByzantinePeriod ;
                       :birthYear 1778 ;
                       :deathYear 1821 ;
                       :hasImageData "images/gregorios_protopsaltis.jpg" ;
                       :hasImageSource "https://commons.orthodoxwiki.org/images/6/69/GrigoriosProtops.jpg" ,
                                       "https://orthodoxwiki.org/File:GrigoriosProtops.jpg" ;
                       rdfs:comment "Gregorios Protopsaltis. Co-reformed Byzantine notation in 1814."@en ,
                                    "Григорий Протопсалт – един от тримата реформатори на нотацията (1814 г.)."@bg ;
                       rdfs:label "Gregorius Protopsaltis"@en ,
                                  "Γρηγόριος Πρωτοψάλτης"@el ,
                                  "Григорий Протопсалт (1778–1821)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#HardChromaticScaleInstance
:HardChromaticScaleInstance rdf:type owl:NamedIndividual ,
                                     :HardChromaticScale ;
                            :tetrachordIntervals "6-20-4" ;
                            rdfs:comment "Интервали: 6м + двойно увеличена (20м) + 4м. Специален ефект; среща се в Седми глас."@bg ;
                            rdfs:label "Hard Chromatic Scale (6-20-4 morae)"@en ,
                                       "Σκληρά χρωματική (6-20-4 μόρια)"@el ,
                                       "Твърд хроматичен звукоред (6-20-4 мории)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#HeirmologicStyle
:HeirmologicStyle rdf:type owl:NamedIndividual ,
                           :ChantStyle ;
                  :description "Най-краткият от трите: на всяка сричка от текста се пада един тон, най-много два. Така се пеят каноните и катавасиите, където текстът е дълъг и трябва да се чуе. Числата по-долу са работна мярка за съставителя, а не канонична величина."@bg ;
                  :notesPerSyllableMax 2 ;
                  :notesPerSyllableMin 1 ;
                  :styleKey "heirmologic" ;
                  rdfs:label "Heirmologic style"@en ,
                             "Εἱρμολογικόν"@el ,
                             "Ирмологичен стил"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Heteron
:Heteron rdf:type owl:NamedIndividual ,
                  :OrnamentalNeume ;
         :hasImageData "images/sign_heteron.png" ;
         rdfs:comment "Alternative ornament sign modifying the neume it accompanies."@en ,
                      "Хетерон – допълнителен белег; уточнява специален изпълнителски ефект."@bg ;
         rdfs:label "Heteron"@en ,
                    "Хетерон (друг знак)"@bg ,
                    "Ἕτερον"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Hyporroe
:Hyporroe rdf:type owl:NamedIndividual ,
                   :BodyNeume ;
          :representsStep :StepPa ;
          :description "Две последователни стъпки надолу; за разлика от елафрон, който покрива същото разстояние със скок."@bg ;
          :intervalSemitones -4 ;
          :intervalValue -2 ;
          :greekName "Ὑπορροή" ;
          :hasImageData "images/sign_hyporroe.png" ;
          rdfs:comment "Two steps down with a smooth gliding character."@en ,
                       "Ипорроé – мека низходяща невма; две последователни стъпки надолу. Интервал: −1."@bg ,
                       "Ипорроé – плавно низходящо движение с две стъпки."@bg ;
          rdfs:label "Hyporroe (two steps down)"@en ,
                     "Ипорроé (две стъпки надолу)"@bg ,
                     "Ὑπορροή"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Hypsili
:Hypsili rdf:type owl:NamedIndividual ,
                  :BodyNeume ;
         :intervalSemitones 8 ;
         :intervalValue 4 ;
         :greekName "Ὑψηλή" ;
         :hasImageData "images/sign_hypsili.png" ;
         rdfs:comment "Four steps up — large ascent."@en ,
                      "Ипсили – голям възходящ скок с четири стъпки (+4)."@bg ,
                      "Ипсили — четири степени нагоре."@bg ;
         rdfs:label "Hypsili"@en ,
                    "Ипсили"@bg ,
                    "Ὑψηλή"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#IoanKukuzel
:IoanKukuzel rdf:type owl:NamedIndividual ,
                      :Chanter ,
                      :Saint ;
             :belongsToSchool :AthoniteTradition ;
             :flourishedDuring :LateByzantinePeriod ;
             :birthYear 1280 ;
             :deathYear 1360 ;
             :hasImageData "images/yoan_kukuzel.png" ;
             :hasImageSource "https://commons.wikimedia.org/wiki/Category:John_Koukouzeles" ;
             rdfs:comment "St. Ioan Kukuzel. Bulgarian-born Byzantine master, called the Angel-voiced."@en ,
                          "Свети Йоан Кукузел – изтъкнат български певец и мелодописец; наречен Ангелогласен."@bg ;
             rdfs:label "Ioan Kukuzel"@en ,
                        "Свети Йоан Кукузел (ок. 1280–1360)"@bg ,
                        "Ἰωάννης Κουκουζέλης"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Ison_neume
:Ison_neume rdf:type owl:NamedIndividual ,
                     :BodyNeume ;
            :representsStep :StepNi ;
            :description "Повтаря същия тон. Изобразява се като малко хоризонтално тире."@bg ;
            :intervalSemitones 0 ;
            :intervalValue 0 ;
            :greekName "Ίσον" ;
            :hasImageData "images/sign_ison.png" ;
            rdfs:comment "Исон – невма за повтаряне на същия тон; изобразява се като малко хоризонтално тире. Интервал: 0."@bg ;
            rdfs:label "Ison (unison)"@en ,
                       "Исон (повторен тон)"@bg ,
                       "Ἴσον"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#JohnOfDamascus
:JohnOfDamascus rdf:type owl:NamedIndividual ,
                         :Hymnographer ,
                         :Saint ;
                :belongsToSchool :EasternOrthodoxTradition ;
                :flourishedDuring :EarlyByzantinePeriod ;
                :birthYear 675 ;
                :deathYear 749 ;
                :hasImageData "images/yoan_damaskin.png" ;
                :hasImageSource "https://commons.wikimedia.org/wiki/Category:John_of_Damascus" ;
                rdfs:comment "St. John of Damascus. Systematised the Octoechos and composed many canons and troparia."@en ,
                             "Свети Йоан Дамаскин – систематизатор на Осмогласника и автор на множество канони и тропари."@bg ;
                rdfs:label "John Of Damascus"@en ,
                           "Свети Йоан Дамаскин (675–749)"@bg ,
                           "Ἰωάννης ὁ Δαμασκηνός"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Kentima
:Kentima rdf:type owl:NamedIndividual ,
                  :BodyNeume ;
         :representsStep :StepVu ;
         :description "Движение нагоре с две стъпки."@bg ;
         :intervalSemitones 4 ;
         :intervalValue 2 ;
         :greekName "Κέντημα" ;
         :hasImageData "images/sign_kentima.png" ;
         rdfs:comment "Small upward ornament, usually combined with Oligon."@en ,
                      "Кентима – знак за движение с две стъпки нагоре. Интервал: +2."@bg ,
                      "Кентима – малко украшение нагоре; обикновено се комбинира с Олигон."@bg ;
         rdfs:label "Kentima (two steps up)"@en ,
                    "Κέντημα"@el ,
                    "Кентима (две стъпки нагоре)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Kentimata
:Kentimata rdf:type owl:NamedIndividual ,
                    :BodyNeume ;
           :description "Две точки една до друга; движение с една стъпка нагоре, без ударение."@bg ;
           :intervalSemitones 2 ;
           :intervalValue 1 ;
           :greekName "Κεντήματα" ;
           :hasImageData "images/sign_kentimata.png" ;
           rdfs:comment "One step up, unstressed; written as two dots."@en ,
                        "Кентимата – двете точки; движение с една стъпка нагоре, без ударение. Интервал: +1."@bg ;
           rdfs:label "Kentimata (one step up)"@en ,
                      "Κεντήματα"@el ,
                      "Кентимата (една стъпка нагоре)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Klasma
:Klasma rdf:type owl:NamedIndividual ,
                 :RhythmicNeume ;
        :hasImageData "images/sign_klasma.png" ;
        rdfs:comment "Doubles the duration of the note it modifies."@en ,
                     "Класма – знак за задържане на тона; удвоява или утроява неговата стойност."@bg ;
        rdfs:label "Klasma"@en ,
                   "Κλάσμα"@el ,
                   "Класма (задържане)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#LateByzantinePeriod
:LateByzantinePeriod rdf:type owl:NamedIndividual ,
                              :HistoricalPeriod ;
                     :precedes :PostByzantinePeriod ;
                     :description "Времето на Палеолозите: разцвет на калофоничното пеене и на учителството, към което принадлежи и Йоан Кукузел."@bg ;
                     rdfs:label "Late Byzantine (Palaiologan) period (13th–15th c.)"@en ,
                                "Късновизантийски (палеологов) период (13–15 в.)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#LowerTetrachord
:LowerTetrachord rdf:type owl:NamedIndividual ,
                          :Scale ;
                 rdfs:comment "Долните четири стъпки на октавата: Νη, Πα, Βου, Γα. Изгражда основата на гласа."@bg ;
                 rdfs:label "Lower Tetrachord (Ni–Pa–Vu–Ga)"@en ,
                            "Κατώτερον τετράχορδον (Νη–Πα–Βου–Γα)"@el ,
                            "Долен тетрахорд (Νη–Πα–Βου–Γα)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#MiddleByzantinePeriod
:MiddleByzantinePeriod rdf:type owl:NamedIndividual ,
                                :HistoricalPeriod ;
                       :precedes :LateByzantinePeriod ,
                                 :PostByzantinePeriod ;
                       :periodEnd 1453 ;
                       :periodStart 900 ;
                       rdfs:comment "Middle Byzantine (9th-15th c.). Flowering of Byzantine chant and the Kalophonic style."@en ,
                                    "Периодът на развитата Byzantine нотация – разцвет на химнографията и невматичното писмо."@bg ;
                       rdfs:label "Middle Byzantine Period (9th–13th c.)"@en ,
                                  "Средновизантийски период (9–13 в.)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode1
:Mode1 rdf:type owl:NamedIndividual ,
                :AuthenticMode ;
       :hasApechema :Apechema1 ;
       :hasAscendingFormula :Ascent1 ;
       :hasCadentialFormula :Cadence1 ;
       :hasDescendingFormula :Descent1 ;
       :hasFinal :StepPa ;
       :hasIson :StepPa ;
       :usesScale :DiatonicScaleInstance ;
       :apechemaNote "Един и същ оборот и в трите стила."@bg ;
       :apechemaSyllables "Ἄνανες" ;
       :ascendingPattern "Oligon–Oligon–Oligon (стъпки нагоре)" ;
       :cadencePattern "Oligon–Apostrophos–Ison (завършва на Πα)" ;
       :character "Тържествен, величествен, подходящ за хвалебни и радостни песнопения" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Apostrophos–Apostrophos–Elaphron" ;
       :description "Устой Πα и в двата стила. Господстващ тон Δη в хирмологичния и Γα в стихерарния."@bg ;
       :finalTone "Πα (Ре)" ;
       :melodicRangeSteps 8 ;
       :modeNumber 1 ;
       :scaleType "диатоничен" ;
       :greekName "Πρωτόηχος (Α΄)" ;
       rdfs:comment "Първи глас (Πρωτόηχος) – тържествен, величествен глас; подходящ за хвалебни и радостни песнопения."@bg ;
       rdfs:label "First Mode (Protos)"@en ,
                  "Πρώτος ήχος"@el ,
                  "Първи глас (Πρωτόηχος)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode2
:Mode2 rdf:type owl:NamedIndividual ,
                :AuthenticMode ;
       :hasApechema :Apechema2 ;
       :hasAscendingFormula :Ascent2 ;
       :hasCadentialFormula :Cadence2 ;
       :hasDescendingFormula :Descent2 ;
       :hasFinal :StepDi ;
       :hasIson :StepDi ;
       :usesScale :SoftChromaticScaleInstance ;
       :apechemaNote "Хирмологичният стил е в мек хроматичен род; стихерарният и папидичният — също, но с друг оборот. Съществува и вариант в твърд хроматичен род."@bg ;
       :apechemaSyllables "Νεανες" ;
       :ascendingPattern "Oligon–Kentima–Oligon (с хроматичен цвят)" ;
       :cadencePattern "Hyporroe–Ison (завършва на Δη)" ;
       :character "Нежен, молитвен, изразяващ смирение и умиление" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Elaphron–Apostrophos" ;
       :description "Устой Δη. В хирмоса на канон родът става твърд хроматичен с устой Πα или Βου."@bg ;
       :finalTone "Δη (Сол)" ;
       :melodicRangeSteps 8 ;
       :modeNumber 2 ;
       :scaleType "мек хроматичен" ;
       :greekName "Δεύτερος ήχος (Β΄)" ;
       rdfs:comment "Втори глас (Δεύτερος) – нежен, молитвен глас; изразява смирение и умиление."@bg ;
       rdfs:label "Second Mode (Deuteros)"@en ,
                  "Δεύτερος ήχος"@el ,
                  "Втори глас (Δεύτερος)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode3
:Mode3 rdf:type owl:NamedIndividual ,
                :AuthenticMode ;
       :hasApechema :Apechema3 ;
       :hasAscendingFormula :Ascent3 ;
       :hasCadentialFormula :Cadence3 ;
       :hasDescendingFormula :Descent3 ;
       :hasFinal :StepGa ;
       :hasIson :StepGa ;
       :usesScale :EnharmonicScaleInstance ;
       :apechemaNote "Завършва на Γα. Един и същ оборот и в трите стила."@bg ;
       :apechemaSyllables "Νανα" ;
       :ascendingPattern "Oligon–Oligon–Kentima" ;
       :cadencePattern "Apostrophos–Elaphron–Ison (завършва на Γα)" ;
       :character "Строг и непреклонен — енхармоничният звукоред няма встъпителен тон. Гръцката традиция чете тази непреклонност като мъжество и величие, славянската — като суровост и покаяние" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Hyporroe–Elaphron" ;
       :description "Устой Γα и в двата стила. Исонът често се мени между Γα и Νη."@bg ;
       :finalTone "Γα (Фа)" ;
       :melodicRangeSteps 8 ;
       :modeNumber 3 ;
       :scaleType "енхармоничен" ;
       :greekName "Τρίτος ήχος (Γ΄)" ;
       rdfs:comment "Трети глас (Τρίτος) – строг и непреклонен; енхармоничният звукоред няма встъпителен тон. Гръцката традиция чете тази непреклонност като мъжество и величие (разширяващ ѐтос, διασταλτικόν), славянската – като суровост и покаяние. Двете описват един и същ звукоред."@bg ;
       rdfs:label "Third Mode (Tritos)"@en ,
                  "Τρίτος ήχος"@el ,
                  "Трети глас (Τρίτος)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode4
:Mode4 rdf:type owl:NamedIndividual ,
                :AuthenticMode ;
       :hasApechema :Apechema4 ;
       :hasAscendingFormula :Ascent4 ;
       :hasCadentialFormula :Cadence4 ;
       :hasDescendingFormula :Descent4 ;
       :hasFinal :StepDi ;
       :hasIson :StepDi ;
       :usesScale :DiatonicScaleInstance ;
       :apechemaNote "От Δη. При хирмологичния „месос“ с завършек на Βου оборотът е Λεγετος — оттам и названието на този вид четвърти глас."@bg ;
       :apechemaSyllables "Ἅγια" ;
       :ascendingPattern "Oligon–Oligon–Oligon" ;
       :cadencePattern "Oligon–Hyporroe–Ison (завършва на Δη)" ;
       :character "Величествен, тържествен и радостен – подходящ за Великден и Пасхалния период" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Elaphron–Hyporroe–Apostrophos" ;
       :description "Устоят зависи от вида на песнопението: Δη при едни, Βου при други („Λέγετος“), Πα при трети. Тук е записан Δη."@bg ;
       :finalTone "Δη (Сол)" ;
       :melodicRangeSteps 8 ;
       :modeNumber 4 ;
       :scaleType "диатоничен" ;
       :greekName "Τέταρτος ήχος (Δ΄)" ;
       rdfs:comment "Четвърти глас (Τέταρτος) – величествен, тържествен и радостен; особено подходящ за Пасхалния период."@bg ;
       rdfs:label "Fourth Mode (Tetartos)"@en ,
                  "Τέταρτος ήχος"@el ,
                  "Четвърти глас (Τέταρτος)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode5
:Mode5 rdf:type owl:NamedIndividual ,
                :PlagalMode ;
       :hasApechema :Apechema5 ;
       :hasAscendingFormula :Ascent5 ;
       :hasCadentialFormula :Cadence5 ;
       :hasDescendingFormula :Descent5 ;
       :hasFinal :StepPa ;
       :hasIson :StepPa ;
       :plagalOf :Mode1 ;
       :usesScale :DiatonicScaleInstance ;
       :apechemaNote "Хирмологичният стил завършва на Κε, стихерарният — на Πα."@bg ;
       :apechemaSyllables "Ἀνεανες" ;
       :ascendingPattern "Oligon–Kentima–Oligon" ;
       :cadencePattern "Apostrophos–Apostrophos–Ison (завършва на Πα)" ;
       :character "Нежен и сладостен, подходящ за хваления на Пресвета Богородица" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Elaphron–Apostrophos–Apostrophos" ;
       :description "Стихерарен стил: устой Πα. Хирмологичният стъпва на Κε — кварта по-високо."@bg ;
       :finalTone "Πα (Ре)" ;
       :melodicRangeSteps 9 ;
       :modeNumber 5 ;
       :scaleType "диатоничен" ;
       :greekName "Πλάγιος Α΄ (πλ. α΄)" ;
       rdfs:comment "Пети глас – плагален на първи (πλ. α΄); нежен и сладостен, подходящ за хваления на Пресвета Богородица."@bg ;
       rdfs:label "Fifth Mode – Plagal First"@en ,
                  "Πλάγιος Α΄ ήχος"@el ,
                  "Пети глас – Плагален първи (πλ. α΄)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode6
:Mode6 rdf:type owl:NamedIndividual ,
                :PlagalMode ;
       :hasApechema :Apechema6 ;
       :hasAscendingFormula :Ascent6 ;
       :hasCadentialFormula :Cadence6 ;
       :hasDescendingFormula :Descent6 ;
       :hasFinal :StepPa ;
       :hasIson :StepPa ;
       :plagalOf :Mode2 ;
       :usesScale :HardChromaticScaleInstance ;
       :apechemaNote "В мек хроматичен род. При твърдия хроматичен оборотът е Νενανω. Според част от музиколозите последният принадлежи на четвърти глас."@bg ;
       :apechemaSyllables "Νεχεανες" ;
       :ascendingPattern "Oligon–Kentima (хроматичен скок)" ;
       :cadencePattern "Hyporroe–Apostrophos–Ison (завършва на Πα)" ;
       :character "Дълбок и тъжен, особено подходящ за покаяние и страдания (Великопостни химни)" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Elaphron–Elaphron" ;
       :description "Стихерарен и папад: твърд хроматичен с устой Πα. Хирмологичният стил е мек хроматичен с устой Δη."@bg ;
       :finalTone "Πα (Ре)" ;
       :melodicRangeSteps 9 ;
       :modeNumber 6 ;
       :scaleType "твърд хроматичен" ;
       :greekName "Πλάγιος Β΄ (πλ. β΄)" ;
       rdfs:comment "Шести глас – плагален на втори (πλ. β΄); дълбок и тъжен, подходящ за Великопостни химни."@bg ;
       rdfs:label "Sixth Mode – Plagal Second"@en ,
                  "Πλάγιος Β΄ ήχος"@el ,
                  "Шести глас – Плагален втори (πλ. β΄)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode7
:Mode7 rdf:type owl:NamedIndividual ,
                :PlagalMode ;
       :hasApechema :Apechema7 ;
       :hasAscendingFormula :Ascent7 ;
       :hasCadentialFormula :Cadence7 ;
       :hasDescendingFormula :Descent7 ;
       :hasFinal :StepGa ;
       :hasIson :StepGa ;
       :plagalOf :Mode3 ;
       :usesScale :EnharmonicScaleInstance ;
       :apechemaNote "Завършва на Γα. Папидичните варианти тръгват от ниското Ζω — веднъж диатонично, веднъж енхармонично — и тъкмо те са дали повода Варис да бъде записван с устой Ζω."@bg ;
       :apechemaSyllables "Ἄανες" ;
       :ascendingPattern "Hypsili–Oligon (голям скок нагоре)" ;
       :cadencePattern "Apostrophos–Elaphron–Ison (завършва на Γα)" ;
       :character "Тежък и дълбок, с характер на смирение и сериозност" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Chamili–Apostrophos (голям скок надолу)" ;
       :description "Варис ползва звукореда и устоя на трети глас, но с други обороти и господстващи тонове. Папидичният му вариант е диатоничен и завършва на ниското Ζω — най-ниският устой в осмогласието."@bg ;
       :finalTone "Γα (Фа)" ;
       :melodicRangeSteps 10 ;
       :modeNumber 7 ;
       :scaleType "енхармоничен" ;
       :greekName "Βαρύς (Βαρύς ήχος)" ;
       rdfs:comment "Седми глас – Тежък (Βαρύς); тежък и дълбок, с характер на смирение и сериозност."@bg ;
       rdfs:label "Seventh Mode – Grave (Barys)"@en ,
                  "Βαρύς ήχος"@el ,
                  "Седми глас – Тежък (Βαρύς)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Mode8
:Mode8 rdf:type owl:NamedIndividual ,
                :PlagalMode ;
       :hasApechema :Apechema8 ;
       :hasAscendingFormula :Ascent8 ;
       :hasCadentialFormula :Cadence8 ;
       :hasDescendingFormula :Descent8 ;
       :hasFinal :StepNi ;
       :hasIson :StepNi ;
       :plagalOf :Mode4 ;
       :usesScale :DiatonicScaleInstance ;
       :apechemaNote "От Νη. Съществува и вариант от Γα."@bg ;
       :apechemaSyllables "Νεαγιε" ;
       :ascendingPattern "Oligon–Oligon–Kentima" ;
       :cadencePattern "Elaphron–Apostrophos–Ison (завършва на Νη)" ;
       :character "Спокоен и уравновесен, с ведра сдържаност. Носи и великите празнични песнопения, и покайните — според текста излиза напред едната или другата страна" ;
       <http://purl.org/dc/terms/source> "https://www.johnsanidopoulos.com/2019/10/the-meaning-and-character-of-eight.html" ;
       :descendingPattern "Apostrophos–Elaphron–Apostrophos" ;
       :description "Устой Νη. Апολυτикиите и канонитe се пренасят на Γα, като разстоянията остават същите."@bg ;
       :finalTone "Νη (До)" ;
       :melodicRangeSteps 8 ;
       :modeNumber 8 ;
       :scaleType "диатоничен" ;
       :greekName "Πλάγιος Δ΄ (πλ. δ΄)" ;
       rdfs:comment "Осми глас – плагален на четвърти (πλ. δ΄); спокоен и уравновесен, с ведра сдържаност. Носи както великите празнични песнопения, тъй и покайните; класическата подялба го отнася към успокояващия ѐтос (ἡσυχαστικόν). Пълнота на осмогласния кръг."@bg ;
       rdfs:label "Eighth Mode – Plagal Fourth"@en ,
                  "Πλάγιος Δ΄ ήχος"@el ,
                  "Осми глас – Плагален четвърти (πλ. δ΄)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#NeoByzantinePeriod
:NeoByzantinePeriod rdf:type owl:NamedIndividual ,
                             :HistoricalPeriod ;
                    :description "Период след реформата на Хрисант Мадитски, Григорий Протопсалт и Хурмузий Хартофилакс (1814). Въвеждане на Новата аналитична нотация. В България – дейност на Неофит Рилски и Атанас Наумов."@bg ;
                    :periodStart 1814 ;
                    rdfs:comment "Периодът след реформата на Хрисант, Григорий и Хурмузий (1814 г.). В България – дейност на Неофит Рилски."@bg ;
                    rdfs:label "Neo-Byzantine Period (1814–present)"@en ,
                               "Неовизантийски период (1814 г. – до днес)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#NeophytRilski
:NeophytRilski rdf:type owl:NamedIndividual ,
                        :Hymnographer ;
               :belongsToSchool :BulgarianChantingTradition ;
               :flourishedDuring :BulgarianRevivalPeriod ;
               <http://purl.org/dc/terms/source> "https://bg.wikipedia.org/wiki/%D0%9D%D0%B5%D0%BE%D1%84%D0%B8%D1%82_%D0%A0%D0%B8%D0%BB%D1%81%D0%BA%D0%B8" ;
               :description "Виден български православен просветител и монах от Рилския манастир (1793–1881). Първият, въвел новата аналитична нотация в България."@bg ;
               :hasImageData "images/neofit_rilski.jpg" ;
               rdfs:comment "Неофит Рилски (1793–1881) – монах, просветител и мелодописец. Въвежда Хурмузиевата реформирана нотация в България и съставя певчески ръководства."@bg ;
               rdfs:label "Neofit Rilski (1793-1881)"@en ,
                          "Νεόφυτος Ρίλσκι"@el ,
                          "Неофит Рилски (1793–1881)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Oligon
:Oligon rdf:type owl:NamedIndividual ,
                 :BodyNeume ;
        :intervalSemitones 2 ;
        :intervalValue 1 ;
        :greekName "Ὀλίγον" ;
        :hasImageData "images/sign_oligon.png" ;
        rdfs:comment "One step up."@en ,
                     "Олигон – стъпка нагоре; основна възходяща невма (+1)."@bg ,
                     "Олигон — една степен нагоре. Основният възходящ знак."@bg ;
        rdfs:label "Oligon"@en ,
                   "Олигон"@bg ,
                   "Ὀλίγον"@el .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#PapadicStyle
:PapadicStyle rdf:type owl:NamedIndividual ,
                       :ChantStyle ;
              :description "Най-обилно разпятият: на една сричка се падат много тонове и текстът се разтяга. Така се пеят херувимските и причастните песнопения, където пеенето покрива дълго свещенодействие."@bg ;
              :notesPerSyllableMax 10 ;
              :notesPerSyllableMin 4 ;
              :styleKey "papadic" ;
              rdfs:label "Papadic style"@en ,
                         "Παπαδικόν"@el ,
                         "Пападически стил"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Petasti
:Petasti rdf:type owl:NamedIndividual ,
                  :BodyNeume ;
         :description "Възходяща извивка; движение с една стъпка нагоре, изпята с ударение и трептене на гласа."@bg ;
         :intervalSemitones 2 ;
         :intervalValue 1 ;
         :greekName "Πεταστή" ;
         :hasImageData "images/sign_petasti.png" ;
         rdfs:comment "One step up, stressed with a flutter of the voice."@en ,
                      "Петасти – възходяща извивка; движение с една стъпка нагоре, изпято с ударение и трептене на гласа. Интервал: +1."@bg ;
         rdfs:label "Petasti (one step up, stressed)"@en ,
                    "Πεταστή"@el ,
                    "Петасти (една стъпка нагоре, с ударение)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#PetrosLampadarios
:PetrosLampadarios rdf:type owl:NamedIndividual ,
                            :Chanter ;
                   :belongsToSchool :ConstantinopolitanSchool ;
                   :hasImageData "images/petar_lambadarii.png" ;
                   :hasImageSource "https://dveri.bg/component/com_content/Itemid,127/catid,93/id,73298/view,article/" ;
                   rdfs:comment "Годината на смъртта се дава различно: едни извори пишат 1777, други 1777/78. Тук се води 1778."@bg ;
                   :flourishedDuring :PostByzantinePeriod ;
                   <http://purl.org/dc/terms/source> "https://www.pravoslavie.bg/?p=1623083" ;
                   <http://purl.org/dc/terms/source> "https://dveri.bg/component/com_content/Itemid,127/catid,93/id,73298/view,article/" ;
                   :birthYear 1730 ;
                   :deathYear 1778 ;
                   rdfs:comment "Petros Lampadarios. Greatest Byzantine composer of the 18th century, Protopsaltis of Constantinople."@en ,
                                "Петър Ламбадарий – протопсалт на Цариград; най-великият византийски мелодописец на 18 в."@bg ;
                   rdfs:label "Petros Lampadarios"@en ,
                              "Πέτρος Λαμπαδάριος"@el ,
                              "Петър Ламбадарий (1730–1777/78)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#PostByzantinePeriod
:PostByzantinePeriod rdf:type owl:NamedIndividual ,
                              :HistoricalPeriod ;
                     :precedes :NeoByzantinePeriod ;
                     :periodEnd 1814 ;
                     :periodStart 1453 ;
                     rdfs:comment "Post-Byzantine (15th-19th c.). Continuation of tradition under Ottoman rule."@en ,
                                  "Периодът след падането на Константинопол – продължение на традицията в Атон и Цариград."@bg ;
                     rdfs:label "Post-Byzantine Period (1453–1814)"@en ,
                                "Поствизантийски период (1453–1814)"@bg .


###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Psifiston
:Psifiston rdf:type owl:NamedIndividual ,
                    :OrnamentalNeume ;
           :hasImageData "images/sign_psifiston.png" ;
           rdfs:comment "A trill or rapid alternation between two adjacent notes."@en ,
