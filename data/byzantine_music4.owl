###  http://www.paralagia.bg/ontology/vizantiiska-muzika#Apostrophos
:Apostrophos rdf:type owl:NamedIndividual ,
                      :BodyNeume ;
             :representsStep :StepNi ;
             :description "Движение надолу с една стъпка; по-бавно от ипорроé."@bg ;
             :intervalSemitones -2 ;
             :intervalValue -1 ;
             :greekName "Ἀπόστροφος" ;
             :hasImageData "images/sign_apostrophos.png" ;
             rdfs:comment "One step down."@en ,
                          "Апострофос – основна низходяща невма; движение с една стъпка надолу. Интервал: −1."@bg ,
                          "Апострофос – стъпка надолу; основна низходяща невма (−1)."@bg ;
             rdfs:label "Apostrophos (one step down)"@en ,
                        "Апострофос (стъпка надолу)"@bg ,
                        "Ἀπόστροφος"@el .


